@page "/"
@page "/{*Path}"
@inherits AppComponent

<PageTitle>@Title</PageTitle>

@if (App.LoadError is { } error)
{
    <div class="boot boot-error">
        <h1>@AppName</h1>
        <p>The app could not start: @error</p>
    </div>
}
else if (!App.Ready || App.Request is null)
{
    <div class="boot">Loading…</div>
}
else
{
    var request = App.Request;
    <div class="app">
        <header class="topbar">
            <div class="brand">
                <img src="@GameIcons.Weapon("great-sword")" alt="" />
                <div>
                    <div class="brand-title">@AppName</div>
                    <div class="brand-sub">MH Wilds build optimizer · Ver @Catalog.GameVersion</div>
                </div>
            </div>
            <ConfigBar />
        </header>

        <nav class="sidenav" aria-label="Sections">
            @foreach (var group in Nav().GroupBy(n => n.Group))
            {
                <div class="navgroup">@group.Key</div>
                @foreach (var item in group)
                {
                    <button class="navitem @(App.Tab == item.Tab ? "active" : "")" @onclick="() => App.SetTab(item.Tab)" title="@item.Label">
                        <img src="@item.Icon" alt="" />
                        <span class="navlabel">@item.Label</span>
                        @if (item.Badge is { } badge)
                        {
                            <span class="navbadge @item.Tone">@badge</span>
                        }
                    </button>
                }
            }
        </nav>

        <main class="content @(App.Tray.Count > 0 && App.Tab != Tab.Compare ? "with-tray" : "")">
            @switch (App.Tab)
            {
                case Tab.Inventory: <InventoryPanel /> break;
                case Tab.Compare: <ComparePanel /> break;
                case Tab.Weapon: <WeaponPanel /> break;
                case Tab.Attack: <ConditionsPanel Part="ConditionsPanel.Parts.Attack" /> break;
                case Tab.Targets: <TargetsPanel /> break;
                case Tab.Conditions: <ConditionsPanel Part="ConditionsPanel.Parts.Hunt" /> break;
                case Tab.Buffs: <BuffsPanel /> break;
                case Tab.Talismans: <TalismansPanel /> break;
                case Tab.Options: <OptionsPanel /> break;
                case Tab.Review: <ReviewPanel /> break;
                case Tab.Results: <ResultsPanel /> break;
                case Tab.Builds: <BuildsPanel /> break;
                case Tab.WikiSkills or Tab.WikiArmor or Tab.WikiItems or Tab.WikiMeals: <WikiPanel /> break;
            }
        </main>
        <TrayBar />

        <footer class="statusbar">
            @{ var resolved = App.Resolved; }
            @if (resolved is null)
            {
                <span class="muted">Validating…</span>
            }
            else if (resolved.Errors.Count > 0)
            {
                <button class="linklike err statuslink" @onclick="() => App.SetTab(Tab.Review)" title="@string.Join("\n", resolved.Errors)">✕ @Fmt.Plural(resolved.Errors.Count, "error") · @resolved.Errors[0]</button>
            }
            else if (resolved.Warnings.Count > 0)
            {
                <button class="linklike warn statuslink" @onclick="() => App.SetTab(Tab.Review)" title="@string.Join("\n", resolved.Warnings)">⚠ @Fmt.Plural(resolved.Warnings.Count, "warning") · @resolved.Warnings[0]</button>
            }
            else
            {
                <span class="ok">Request is valid@(resolved.Baseline is { } b ? $" · weapon-only baseline {b.Total:0.0}" : "")</span>
            }
            @if (App.Solver?.Problem is { } problem)
            {
                <span class="err">@problem</span>
            }
            <span class="muted right">
                @Catalog.Skills.Count skills · @Catalog.Decorations.Count decorations · @Catalog.ArmorSets.Count armor sets · runs in your browser@(App.Solver is { } s ? $" ({s.Cores} cores)" : "") · data wilds.mhdb.io, icons monsterhunterwiki.org
            </span>
        </footer>
    </div>
}

@code {
    [Parameter] public string? Path { get; set; }

    private bool _started;

    private sealed record NavItem(string Group, Tab Tab, string Label, string Icon, string? Badge = null, string? Tone = null);

    private const string GroupProfile = "Profile";
    private const string GroupWeapon = "Weapon";
    private const string GroupBuilds = "Builds";
    private const string GroupWiki = "Wiki";

    protected override async Task OnInitializedAsync()
    {
        if (_started) return;
        _started = true;
        await App.InitializeAsync();
    }

    private const string AppName = "Wilds Builds";

    /// <summary>The browser tab's title; while a run goes it leads with the run's stage, so a background tab shows how far it got.</summary>
    private string Title => (App.Run.Status == RunStatus.Running ? $"⏳ {RunTitle(App.Run)} · " : "") + (App.Tab == Tab.Inventory || App.Request is null
        ? $"{AppName} · Monster Hunter Wilds build optimizer"
        : App.Tab.IsWikiTab() ? $"{App.WikiEntry ?? Nav().First(n => n.Tab == App.Tab).Label} · MH Wilds wiki · {AppName}"
        : App.Tab == Tab.Compare ? $"Compare · {AppName}"
        : $"{App.Name ?? "New weapon"} · {Nav().First(n => n.Tab == App.Tab).Label} · {AppName}");

    /// <summary>"Searching 3:12 · build 2 of 5": the deepest stage only, the title is short.</summary>
    private static string RunTitle(RunState run)
    {
        var elapsed = run.StartedAt is { } started ? DateTimeOffset.Now - started : TimeSpan.Zero;
        var last = run.Stage?.Split(" · ").LastOrDefault(x => x.Length > 0);
        return $"Searching {(int)elapsed.TotalMinutes}:{elapsed.Seconds:00}" + (last is null ? "" : $" · {last}");
    }

    private IEnumerable<NavItem> Nav()
    {
        var request = App.Request!;
        var conditionsOn = Catalog.Conditions.Count(c => c.Group is not (ConditionCatalog.GroupProcs or ConditionCatalog.GroupBuffs) && ConditionAccess.Get(request.Conditions, c.Property));
        var buffsOn = request.Conditions.Buffs.Count + (request.Conditions.Powercharm ? 1 : 0) + (request.Conditions.MealAttack > 0 ? 1 : 0);
        var rules = request.TargetSkills.Keys.Union(request.Conditions.SkillLimits.Keys).Count();
        var errors = App.Resolved?.Errors.Count ?? 0;
        var warnings = App.Resolved?.Warnings.Count ?? 0;
        var kind = App.WeaponKind;
        var busy = App.Batch.Values.Count(b => b.Status is BatchStatus.Running or BatchStatus.Queued);
        string? Count(int n) => n > 0 ? n.ToString() : null;

        // profile-wide things first, then the open weapon's setup, then what comes out of it
        yield return new(GroupProfile, Tab.Inventory, "Weapons", GameIcons.WeaponBase(kind), busy > 0 ? $"{busy} …" : Count(App.Weapons.Count));
        yield return new(GroupProfile, Tab.Talismans, "Talismans", GameIcons.Talisman(7), Count(App.Talismans.Count));
        yield return new(GroupProfile, Tab.Compare, "Compare", GameIcons.SkillGeneric("handicraft"), Count(App.Tray.Count), App.Tray.Count > 0 ? "acc" : null);
        yield return new(GroupWeapon, Tab.Weapon, "Weapon", GameIcons.Weapon(kind));
        yield return new(GroupWeapon, Tab.Attack, "Attack & target", GameIcons.Attack);
        yield return new(GroupWeapon, Tab.Targets, "Targets & limits", GameIcons.SkillGeneric("offense"), Count(rules));
        yield return new(GroupWeapon, Tab.Conditions, "Conditions", GameIcons.SkillGeneric("attack"), $"{conditionsOn} on");
        yield return new(GroupWeapon, Tab.Buffs, "Buffs", GameIcons.Item("drug", "red"), Count(buffsOn));
        yield return new(GroupWeapon, Tab.Options, "Options", GameIcons.Defense);
        yield return new(GroupBuilds, Tab.Review, "Review", GameIcons.SkillGeneric("item"),
            errors > 0 ? $"{errors} err" : warnings > 0 ? $"{warnings} warn" : "ok", errors > 0 ? "err" : warnings > 0 ? "warn" : "ok");
        yield return new(GroupBuilds, Tab.Results, "Results", GameIcons.Affinity,
            App.Run.Status == RunStatus.Running ? "…" : App.Run.Result is { } r ? r.Pairs.Sum(p => p.Builds.Count).ToString() : null);
        yield return new(GroupBuilds, Tab.Builds, "My builds", GameIcons.Armor(ArmorPieceKind.Chest, 8), Count(App.Builds.Count));
        yield return new(GroupWiki, Tab.WikiSkills, "Skills", GameIcons.SkillGeneric("attack"));
        yield return new(GroupWiki, Tab.WikiArmor, "Armor", GameIcons.Armor(ArmorPieceKind.Head, 8));
        yield return new(GroupWiki, Tab.WikiItems, "Items", GameIcons.Item("drug", "red"));
        yield return new(GroupWiki, Tab.WikiMeals, "Meals", GameIcons.Item("meat", "orange"));
    }
}
