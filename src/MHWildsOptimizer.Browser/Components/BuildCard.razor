@using System.Text.RegularExpressions
@*
    One scored build. Title replaces "Build <rank>"; Delta (e.g. the difference to your own build) sits next to the score;
    Actions go to the right of the header; Summary opens the body; Compact leaves out the equipment table and decoration list (the build editor shows those).
*@
@{
    var b = Build;
    var s = b.Summary;
    var w = b.Weapon;
}
<article class="build @(Best ? "best" : "")">
    <header class="build-head">
        <div class="build-rank">@(TitleContent ?? (r => r.AddContent(0, Title ?? $"Build {b.Rank}")))</div>
        <div class="score">
            @if (BuildDamage.Of(b) is { } damage)
            {
                var r = b.StatsRequested;
                @if (r.Attacks is { Count: > 0 })
                {
                    <button type="button" class="dmg-toggle" title="@ScoreTitle(b)" aria-expanded="@(_breakdown ? "true" : "false")" @onclick="() => _breakdown = !_breakdown">
                        <span class="total">@Fmt.N(damage, 0)</span>
                        <span class="muted">@BuildDamage.Label(b) <span class="caret">@(_breakdown ? "▾" : "▸")</span></span>
                    </button>
                }
                else
                {
                    <span class="total" title="@ScoreTitle(b)">@Fmt.N(damage, 0)</span>
                    <span class="muted">@BuildDamage.Label(b)</span>
                }
                @if (Math.Round(b.StatsAllOn.DamagePerExecution) > Math.Round(damage))
                {
                    <span class="muted small" title="The same attack if every hunt condition on the Conditions tab were on: the most this build can deal, when everything its skills wait for happens at once">
                        up to @Fmt.N(b.StatsAllOn.DamagePerExecution, 0) with every condition on
                    </span>
                }
            }
            else
            {
                <span class="efr">EFR @Fmt.N(b.Efr)</span>
                <span class="plus">+</span>
                <span class="efe">EFE @Fmt.N(b.Efe)</span>
                @if (b.Procs > 0)
                {
                    <span class="plus">+</span>
                    <span class="procs" title="@string.Join(", ", s.ProcSources)">procs @Fmt.N(b.Procs)</span>
                }
                <span class="eq">=</span>
                <span class="total">@Fmt.N(b.Score)</span>
                @if (Math.Round(s.TotalAllConditions, 2) > Math.Round(b.Score, 2))
                {
                    <span class="muted small" title="The score if every hunt condition on the Conditions tab were on">up to @Fmt.N(s.TotalAllConditions) with every condition on</span>
                }
            }
            @Delta
            @if (b.Proof is { Kind: Core.Optimize.ProofKind.TimeLimit } proof)
            {
                <span class="badge-mini warnbadge" title="@ProofTitle(proof)">not proved</span>
            }
        </div>
        <div class="statchips">
            <StatHover Class="statchip atk" Tip="AttackTip(b)"><img src="@GameIcons.Attack" alt="" />ATK <b>@Fmt.N(s.Attack, 0)</b></StatHover>
            <StatHover Class="statchip aff" Tip="AffinityTip(b)">
                <img src="@GameIcons.Affinity" alt="" />AFF <b>@(s.Affinity)%</b>
                @if (s.AffinityMin is { } lo && s.AffinityMax is { } hi)
                {
                    <small>@lo-@(hi)%</small>
                }
            </StatHover>
            <StatHover Class="statchip crit" Tip="CritTip(b)">CRIT <b>x@(Fmt.N(s.CritMultiplier, 2))</b></StatHover>
            @if (s.Sharpness is { } sharp)
            {
                <span class="statchip sharp" style="--tint: @GameIcons.SharpnessCss[sharp]"><img src="@GameIcons.Sharpness" alt="" />@Fmt.TitleCase(sharp)</span>
            }
            @if (s.Element != Element.None)
            {
                var icon = GameIcons.Element(s.Element);
                <span class="statchip ele" style="--tint: @GameIcons.ElementCss[s.Element]">
                    @if (icon is not null)
                    {
                        <img src="@icon" alt="" />
                    }
                    @Fmt.TitleCase(s.Element) <b>@s.ElementDisplay</b>
                </span>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="build-actions">@Actions</div>
        }
    </header>

    <div class="build-body">
        @Summary
        @if (_breakdown)
        {
            <DamageBreakdown Build="b" />
        }
        <div class="build-row">
            <span class="label">Sets</span>
            <span class="chip-row">
                @if (s.ActiveSetBonuses.Count == 0)
                {
                    <span class="muted">-</span>
                }
                @foreach (var x in s.ActiveSetBonuses)
                {
                    <SkillHover @key="x" Name="@x" Class="chip skill set"><SkillIcon Name="@SetTier.Replace(x, "")" Kind="SkillKind.Set" Size="18" />@x</SkillHover>
                }
            </span>
            <span class="label">Groups</span>
            <span class="chip-row">
                @if (s.ActiveGroupSkills.Count == 0)
                {
                    <span class="muted">-</span>
                }
                @foreach (var x in s.ActiveGroupSkills)
                {
                    var bare = Parenthesis.Replace(x, "");
                    <SkillHover @key="x" Name="@bare" Class="chip skill group"><SkillIcon Name="@bare" Kind="SkillKind.Group" Size="18" />@x</SkillHover>
                }
            </span>
        </div>
        <div class="build-row">
            <span class="label">Skills</span>
            <span class="chip-row">
                @foreach (var x in b.Skills)
                {
                    <SkillChip @key="x.Skill" Name="@x.Skill" Level="x.Level" Effective="x.Effective" Wasted="x.Wasted" />
                }
            </span>
        </div>
        <WeaponOptionsView Build="b" OnUseWeapon="OnUseWeapon" />

        @if (!Compact)
        {
            <table class="table equip">
                <tbody>
                    <tr>
                        <td class="icon-cell"><img class="icon" src="@GameIcons.Weapon(w.Type)" alt="" width="32" height="32" /></td>
                        <td class="piece">Weapon</td>
                        <td class="name">
                            <b>@w.Label</b>
                            <div class="muted small">@w.TrueRaw attack, @(w.Affinity)% affinity, @(w.Element == Element.None ? "no element" : $"{w.ElementDisplay} {Fmt.TitleCase(w.Element)}"), @WeaponFinish(w)</div>
                            @if (w.SetBonus is not null || w.GroupSkill is not null)
                            {
                                @* the rolled skills, shown like an armor piece's *@
                                <div class="muted small">
                                    @if (w.SetBonus is { } wb)
                                    {
                                        <SkillHover Name="@wb" Class="with-icon"><SkillIcon Name="@wb" Kind="SkillKind.Set" Size="14" />@wb</SkillHover>
                                    }
                                    @if (w.GroupSkill is { } wg)
                                    {
                                        <SkillHover Name="@wg" Class="with-icon"><SkillIcon Name="@wg" Kind="SkillKind.Group" Size="14" />@wg</SkillHover>
                                    }
                                </div>
                            }
                        </td>
                        <td class="skills"></td>
                        <td class="decos">@SlotDecos(w.Decorations, numbers: w.Slots)</td>
                    </tr>
                    @foreach (var a in b.Armor)
                    {
                        <tr @key="a.Kind">
                            <td class="icon-cell"><img class="icon" src="@GameIcons.Armor(a.Kind, a.Rarity)" alt="" width="32" height="32" /></td>
                            <td class="piece">@BuildHelpers.PieceLabel(a.Kind)</td>
                            <td class="name">
                                <b>@a.Name</b> <RarityBadge Rarity="a.Rarity" Transcended="a.Transcended" />
                                <div class="muted small">
                                    @foreach (var x in a.SetBonus)
                                    {
                                        <SkillHover @key="x" Name="@x" Class="with-icon"><SkillIcon Name="@x" Kind="SkillKind.Set" Size="14" />@x</SkillHover>
                                    }
                                    @if (a.GroupSkill is { } g)
                                    {
                                        <SkillHover Name="@g" Class="with-icon"><SkillIcon Name="@g" Kind="SkillKind.Group" Size="14" />@g</SkillHover>
                                    }
                                </div>
                            </td>
                            <td class="skills">
                                <span class="chip-row">
                                    @foreach (var grant in a.Skills)
                                    {
                                        <SkillChip @key="grant.Skill" Name="@grant.Skill" Level="grant.Level" />
                                    }
                                </span>
                            </td>
                            <td class="decos">@SlotDecos(a.Decorations, numbers: a.Slots)</td>
                        </tr>
                    }
                    <tr>
                        <td class="icon-cell">
                            @if (b.Talisman is { } ti)
                            {
                                <img class="icon" src="@GameIcons.Talisman(ti.Rarity)" alt="" width="32" height="32" />
                            }
                        </td>
                        <td class="piece">Talisman</td>
                        @if (b.Talisman is { } t)
                        {
                            <td class="name">
                                <b>@t.Name</b> <RarityBadge Rarity="t.Rarity" />
                                <div class="muted small">@(t.Source switch { TalismanSource.Random => "your random talisman", TalismanSource.Possible => "possible roll, you may not own it", _ => "craftable charm" })</div>
                            </td>
                            <td class="skills">
                                <span class="chip-row">
                                    @foreach (var grant in t.Skills)
                                    {
                                        <SkillChip @key="grant.Skill" Name="@grant.Skill" Level="grant.Level" />
                                    }
                                </span>
                            </td>
                            <td class="decos">@SlotDecos(t.Decorations, named: t.Slots)</td>
                        }
                        else
                        {
                            <td colspan="3" class="muted">-</td>
                        }
                    </tr>
                </tbody>
            </table>

            <div class="build-row">
                <span class="label">Decorations (@b.Decorations.Sum(d => d.Count))</span>
                <span class="chip-row">
                    @if (b.Decorations.Count == 0)
                    {
                        <span class="muted">none</span>
                    }
                    @foreach (var d in b.Decorations)
                    {
                        var skills = string.Join(", ", d.Skills.Select(g => $"{g.Skill} {g.Level}"));
                        <span @key="d.Name" class="chip deco" title="@skills">
                            <DecoIcon Deco="@(new DecoDto(d.Name, d.Slot, d.Kind, d.IconColor, d.Skills))" Size="20" />
                            <b>@(d.Count)×</b> @d.Name
                            <span class="muted small">@skills</span>
                        </span>
                    }
                </span>
            </div>
        }

        <button type="button" class="linklike details-toggle" @onclick="() => _open = !_open">@(_open ? "▾ Hide details" : "▸ Skill sources, stats and the text report")</button>

        @if (_open)
        {
            <div class="details">
                <h4>Skills with sources</h4>
                <table class="table sources">
                    <tbody>
                        @foreach (var x in b.Skills)
                        {
                            <tr @key="x.Skill">
                                <td><SkillChip Name="@x.Skill" Level="x.Level" Effective="x.Effective" /></td>
                                <td class="muted small">@string.Join(", ", x.Sources)@if (x.Wasted > 0) {<span class="warn">@(" · ")@x.Wasted wasted</span>}</td>
                            </tr>
                        }
                        <tr>
                            <td class="muted">Set bonuses</td>
                            <td class="small">
                                @if (b.SetBonuses.Count == 0)
                                {
                                    @("-")
                                }
                                @foreach (var x in b.SetBonuses)
                                {
                                    <span @key="x.Name" class="pc @(x.Active ? "active" : "")">@x.Name @(x.Pieces)pc@(x.Active ? $" → {Fmt.Roman(x.Tier)}{(x.TierName is { } tn ? $" ({tn})" : "")}" : "")</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="muted">Group skills</td>
                            <td class="small">
                                @if (b.GroupSkills.Count == 0)
                                {
                                    @("-")
                                }
                                @foreach (var x in b.GroupSkills)
                                {
                                    <span @key="x.Name" class="pc @(x.Active ? "active" : "")">@x.Name @(x.Pieces)pc@(x.Active ? $" ACTIVE{(x.RankName is { } rn ? $" ({rn})" : "")}" : "")</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="stats-compare">
                    @StatsBlock("Under the requested conditions", b.StatsRequested, w.Type)
                    @StatsBlock("Every conditional skill active", b.StatsAllOn, w.Type)
                </div>

                <details>
                    <summary>Plain-text report</summary>
                    <pre class="rawtext">@b.Text</pre>
                </details>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public BuildDto Build { get; set; } = default!;
    [Parameter] public bool Best { get; set; }
    /// <summary>Replaces "Build &lt;rank&gt;"; <see cref="TitleContent"/> replaces it when given.</summary>
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    /// <summary>Shown next to the score, e.g. a <see cref="ScoreDelta"/>.</summary>
    [Parameter] public RenderFragment? Delta { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    /// <summary>First thing in the body, e.g. how the build differs from the one it is compared with.</summary>
    [Parameter] public RenderFragment? Summary { get; set; }
    [Parameter] public bool Compact { get; set; }
    /// <summary>With weapon tuning: "Use this weapon" puts the build's weapon on the Weapon tab.</summary>
    [Parameter] public EventCallback<GogmaWeaponSpecInput> OnUseWeapon { get; set; }

    private bool _open;
    private bool _breakdown;

    /// <summary>The tier and rank name of a set bonus display name, so the icon is the set's: "Gore Magala's Tyranny II (Black Eclipse)".</summary>
    private static readonly Regex SetTier = new(@" (I|II)( \(.*\))?$");

    private static readonly Regex Parenthesis = new(@" \(.*\)$");

    /// <summary>The decorations in their slots; slot levels are numbers, or talisman notation ("weapon2") for <paramref name="named"/>.</summary>
    private static RenderFragment SlotDecos(IReadOnlyList<DecoDto?> decos, IReadOnlyList<int>? numbers = null, IReadOnlyList<string>? named = null) => __builder =>
    {
        var levels = numbers ?? (named ?? []).Select(x => int.TryParse(new string(x.Where(char.IsDigit).ToArray()), out var n) ? n : 0).ToList();
        if (levels.Count == 0)
        {
            <span class="muted small">no slots</span>
            return;
        }
        <span class="slotdecos">
            <span class="slotdeco-row">
                @for (var i = 0; i < levels.Count; i++)
                {
                    var deco = i < decos.Count ? decos[i] : null;
                    <span class="slotdeco">
                        <DecoIcon Deco="deco" SlotLevel="levels[i]" Size="28" />
                        <span class="muted tiny">@(deco?.Name ?? "empty")</span>
                    </span>
                }
            </span>
            <span class="muted small slotdeco-levels" title="slot levels"><Slots Numbers="numbers" Named="named" /></span>
        </span>
    };

    private static string ProofTitle(Core.Optimize.SolveProof p) =>
        $"The solver found this build but ran out of its {p.TimeLimitSeconds:0.#} s time limit before it could prove it the best: a build up to {p.GapPercent:0.#}% better may exist (the solver's bound, usually far above what any build reaches). A longer time limit per solve in Options lets it finish.";

    /// <summary>"White sharpness"; a bow has no sharpness but a coating ("Pierce coating").</summary>
    private static string WeaponFinish(BuildWeaponDto w) =>
        w.Sharpness is { } sharp ? $"{Fmt.TitleCase(sharp)} sharpness"
        : w.Type == "bow" ? (w.Spec is { } spec ? $"{AttackProfile.CoatingName(Core.Gogma.GogmaConstants.BowCoatingOf(spec.Focus))} coating" : "bow coating")
        : "no sharpness";

    private static string ScoreTitle(BuildDto b) =>
        $"Against the target, before the monster's defense rate and per-hit rounding. Score: EFR {Fmt.N(b.Efr)} + EFE {Fmt.N(b.Efe)}"
        + (b.Procs > 0 ? $" + procs {Fmt.N(b.Procs)}" : "") + $" = {Fmt.N(b.Score)} per 100 MV; it ranks builds the same as the damage.";

    // "Agitator (+15%)", "Latent Power, 50% of the time (+50%)": the value is the first parenthesis that starts with a sign or x
    private static readonly Regex SourceParts = new(@"^(?<label>.+?) \((?<value>[+\-x]\d.*)\)$");
    private static readonly Regex TimeShare = new(@"^(?<label>.+), (?<share>[\d.]+% of the time)$");

    private static bool AnyTimed(IReadOnlyList<string> sources) => sources.Any(x => x.Contains("% of the time ("));

    private static RenderFragment SourceRows(string baseLabel, string baseValue, IReadOnlyList<string> sources) => __builder =>
    {
        <tr><td>@baseLabel</td><td>@baseValue</td></tr>
        @foreach (var src in sources)
        {
            var m = SourceParts.Match(src);
            var (label, value) = m.Success ? (m.Groups["label"].Value, m.Groups["value"].Value) : (src, "");
            var t = TimeShare.Match(label);
            <tr>
                <td>@(t.Success ? t.Groups["label"].Value : label)@if (t.Success) {<span class="muted">, @t.Groups["share"].Value</span>}</td>
                <td>@value</td>
            </tr>
        }
    };

    private static RenderFragment AttackTip(BuildDto b) => __builder =>
    {
        var s = b.Summary;
        <table>
            @SourceRows("Weapon", s.BaseAttack.ToString(), s.RawSources)
            <tr class="total"><td>Attack</td><td>@Fmt.N(s.Attack, 0)</td></tr>
        </table>
        <span class="muted">@s.DisplayAttack as shown in game.</span>
        @if (AnyTimed(s.RawSources))
        {
            <span class="muted">Some boosts are on for part of the hunt. The attack is the one of its longest part.</span>
        }
    };

    private static RenderFragment AffinityTip(BuildDto b) => __builder =>
    {
        var s = b.Summary;
        var range = s.AffinityMin is not null && s.AffinityMax is not null;
        <table>
            @SourceRows("Weapon", $"{s.BaseAffinity}%", s.AffinitySources)
            <tr class="total"><td>@(range ? "Average" : "Affinity")</td><td>@(s.Affinity)%</td></tr>
            @if (range)
            {
                <tr><td>Lowest</td><td>@(s.AffinityMin)%</td></tr>
                <tr><td>Highest</td><td>@(s.AffinityMax)%</td></tr>
            }
        </table>
        @if (range || AnyTimed(s.AffinitySources))
        {
            <span class="muted">Timed sources are on for part of the hunt. Each part is scored with its own affinity.</span>
        }
        @if (s.Affinity >= 100)
        {
            <span class="muted">Capped at 100%.</span>
        }
    };

    private static RenderFragment CritTip(BuildDto b) => __builder =>
    {
        var s = b.Summary;
        var r = b.StatsRequested;
        var level = b.Skills.FirstOrDefault(x => x.Skill == Core.Damage.SkillNames.CriticalBoost)?.Effective ?? 0;
        <table>
            <tr><td>@(level > 0 ? $"Critical Boost {level}" : "Base crit")</td><td>x@(Fmt.N(s.CritMultiplier, 2))</td></tr>
            @if (r.ElementTrue > 0)
            {
                <tr><td>Element crit</td><td>x@(Fmt.N(r.CritElement, 2))</td></tr>
            }
            <tr class="total"><td>Raw per hit at @(s.Affinity)%</td><td>x@(Fmt.N(r.CritFactor, 3))</td></tr>
        </table>
        @if (s.Affinity < 0)
        {
            <span class="muted">Negative affinity: feeble hits do x0.75 instead.</span>
        }
    };

    private static RenderFragment StatsBlock(string title, StatsDto r, string weaponType) => __builder =>
    {
        <div class="statsblock">
            <h4>@title</h4>
            <dl>
                <dt>Attack</dt><dd>@Fmt.N(r.TrueRaw, 1)</dd>
                <dt>Affinity</dt><dd>@(r.Affinity)% <span class="muted">crit x@(Fmt.N(r.CritMultiplier, 2)), factor @Fmt.N(r.CritFactor, 3)</span></dd>
                <dt>Sharpness</dt><dd>@(r.Sharpness is { } sh ? Fmt.TitleCase(sh) : "-") <span class="muted">raw x@(Fmt.N(r.SharpnessRaw, 3)), element x@(Fmt.N(r.SharpnessElement, 4))</span></dd>
                @if (r.ElementTrue > 0)
                {
                    <dt>Element</dt><dd>@r.ElementDisplay <span class="muted">(cap @Fmt.N(r.ElementCap * 10, 0), crit element x@(Fmt.N(r.CritElement, 2)))</span></dd>
                }
                @if (r.ScoredOn is { } scoredOn)
                {
                    <dt>Scored on</dt><dd><ScoredAttack ScoredOn="@scoredOn" WeaponType="@weaponType" /></dd>
                }
                <dt>Score</dt>
                <dd><b>EFR @Fmt.N(r.Efr)</b> + <b>EFE @Fmt.N(r.Efe)</b>@if (r.Procs > 0) {@(" + ")<b>procs @Fmt.N(r.Procs)</b>}@(" = ")<b class="total">@Fmt.N(r.Total)</b> <span class="muted">per 100 MV</span></dd>
                @if (r.DamagePerExecution > 0)
                {
                    <dt>Damage</dt>
                    <dd title="Against the target, before the monster's defense rate and per-hit rounding. Ranks builds exactly like the score.">
                        <b>@Fmt.N(r.DamagePerExecution, 0)</b> per @(r.Execution ?? "attack")
                    </dd>
                }
            </dl>
            @if (r.Modifiers.Count > 0)
            {
                <ul class="mods">
                    @foreach (var m in r.Modifiers)
                    {
                        <li>@m</li>
                    }
                </ul>
            }
        </div>
    };
}
