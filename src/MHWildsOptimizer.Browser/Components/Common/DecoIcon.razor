@inject AppState App
@inherits HoverTip
@* A decoration's icon (from a result's DecoDto or the catalog's DecorationDto), or an empty slot of a level when neither is given.
   With Card, hovering it (tapping on a phone) shows the jewel and the cards of the skills it carries. Like InfoHover, the
   MudTooltip is only created once the pointer gets there, with the same markup standing in until then: builds list dozens of jewels. *@
@{
    var name = Deco?.Name ?? Decoration?.Name;
}
@if (name is null)
{
    <span class="deco-empty" style="width: @(Size)px; height: @(Size)px" title="@(SlotLevel is { } l ? $"empty level {l} slot" : "empty slot")">@SlotLevel</span>
}
else
{
    var slot = Deco?.Slot ?? Decoration!.Slot;
    var kind = Deco?.Kind ?? Decoration!.Kind;
    var skills = Deco?.Skills ?? Decoration!.Skills;
    var text = $"{name}: {string.Join(", ", skills.Select(g => $"{g.Skill} {g.Level}"))}";
    var src = GameIcons.Decoration(slot, kind, Deco?.IconColor ?? Decoration?.IconColor);
    if (!Card)
    {
        <img class="icon deco" width="@Size" height="@Size" src="@src" alt="@name" title="@text" />
    }
    else if (Armed)
    {
        <MudTooltip Placement="Placement.Bottom" Delay="150" Class="skilltip-pop" RootClass="decohover" RootStyle="display: inline-flex" Visible="Visible" VisibleChanged="OnVisibleChanged">
            <ChildContent><img @ref="Anchor" class="icon deco" width="@Size" height="@Size" src="@src" alt="@text" /></ChildContent>
            <TooltipContent>
                <div class="decotip">
                    <div class="decotip-head">
                        <img class="icon" width="22" height="22" src="@src" alt="" />
                        <b>@name</b>
                        <span class="muted small right">level @slot @(kind == SkillKind.Weapon ? "weapon" : "armor") jewel</span>
                    </div>
                    @foreach (var g in skills)
                    {
                        if (App.Index.SkillsByName.GetValueOrDefault(g.Skill) is { } skill)
                        {
                            <SkillCard Skill="skill" Level="g.Level" />
                        }
                        else
                        {
                            <div class="decotip-head">@g.Skill @g.Level</div>
                        }
                    }
                </div>
            </TooltipContent>
        </MudTooltip>
    }
    else
    {
        <span class="mud-tooltip-root mud-tooltip-inline decohover" style="display: inline-flex" @onpointerenter="Arm">
            <img class="icon deco" width="@Size" height="@Size" src="@src" alt="@text" />
        </span>
    }
}

@code {
    [Parameter] public DecoDto? Deco { get; set; }
    [Parameter] public DecorationDto? Decoration { get; set; }
    [Parameter] public int? SlotLevel { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    /// <summary>Show the skill card on hover; off where the skills are written next to the icon (pickers) and a plain title does.</summary>
    [Parameter] public bool Card { get; set; } = true;
}
