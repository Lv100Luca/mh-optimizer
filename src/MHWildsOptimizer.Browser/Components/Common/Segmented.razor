@typeparam T
@* One choice out of a few, as a row of joined buttons (the server client's segmented control). *@
<div class="segmented @(Small ? "small" : "")" role="radiogroup">
    @foreach (var o in Options)
    {
        <button type="button" role="radio" aria-checked="@Equals(o.Value, Value)" title="@o.Hint" disabled="@o.Disabled"
                class="@(Equals(o.Value, Value) ? "active" : "")" @onclick="() => ValueChanged.InvokeAsync(o.Value)">
            @if (o.Content is not null) { @o.Content } else { @o.Label }
        </button>
    }
</div>

@code {
    [Parameter] public T Value { get; set; } = default!;
    [Parameter] public EventCallback<T> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<SegmentOption<T>> Options { get; set; } = [];
    [Parameter] public bool Small { get; set; }
}
