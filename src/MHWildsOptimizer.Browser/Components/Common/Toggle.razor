@* A switch with a label and an optional hint. *@
<div class="toggle-row @(Disabled ? "disabled" : "")">
    <MudSwitch T="bool" Value="Checked" ValueChanged="CheckedChanged" Disabled="Disabled" Color="Color.Primary" Size="Size.Small" />
    <span class="toggle-text">
        <span>@if (LabelContent is not null) { @LabelContent } else { @Label }</span>
        @if (Hint is not null)
        {
            <span class="field-hint">@Hint</span>
        }
    </span>
</div>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? LabelContent { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
