@* A talisman's decoration slots, one row per slot: weapon or armor kind, and no slot or level 1 to 3. Slots stay in the game's
   order (the weapon slot first, then armor slots from the highest level), and choices that make a layout random talismans
   cannot roll are greyed out. The value is talisman notation: "weapon1,armor1" ("" for none). *@
@{
    var rows = Rows();
}
<div class="talisman-slots">
    @for (var i = 0; i < SlotCount; i++)
    {
        var index = i;
        var (kind, level) = rows[i];
        <div @key="index" class="talisman-slot-row">
            <span class="muted small">@(index + 1)</span>
            <Segmented T="string" Small="true" Value="kind" ValueChanged="k => SetKind(index, k)" Options="KindOptions(rows, index)" />
            <Segmented T="int" Small="true" Value="level" ValueChanged="l => SetLevel(index, l)" Options="LevelOptions(rows, index)" />
        </div>
    }
</div>

@code {
    /// <summary>Talisman notation, e.g. "weapon1,armor1"; "" for no slots.</summary>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>The layouts random talismans can roll, in the same notation ("" included).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Patterns { get; set; } = [];

    private const int SlotCount = 3;
    private const string Weapon = "weapon";
    private const string Armor = "armor";

    /// <summary>The kind picked on a row without a slot yet (it takes effect with the level).</summary>
    private readonly string[] _pending = [Armor, Armor, Armor];

    private HashSet<string> Valid => _valid ??= Patterns.Select(p => Key(Parse(p))).ToHashSet();
    private HashSet<string>? _valid;
    private IReadOnlyList<string>? _validFor;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_validFor, Patterns)) { _validFor = Patterns; _valid = null; }
    }

    private static List<(string Kind, int Level)> Parse(string value) =>
        value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => (s.StartsWith('w') ? Weapon : Armor, BuildHelpers.ParseSlot(s).Level)).ToList();

    /// <summary>The game's order: the weapon slot first, then armor slots from the highest level.</summary>
    private static List<(string Kind, int Level)> Ordered(IEnumerable<(string Kind, int Level)> slots) =>
        slots.Where(s => s.Level > 0).OrderBy(s => s.Kind == Weapon ? 0 : 1).ThenByDescending(s => s.Level).ToList();

    private static string Key(IEnumerable<(string Kind, int Level)> slots) => string.Join(",", Ordered(slots).Select(s => s.Kind + s.Level));

    /// <summary>The three rows: the slots in order, then rows without a slot (with their pending kind).</summary>
    private List<(string Kind, int Level)> Rows()
    {
        var slots = Ordered(Parse(Value));
        var rows = slots.Take(SlotCount).ToList();
        for (var i = rows.Count; i < SlotCount; i++) rows.Add((_pending[i], 0));
        return rows;
    }

    /// <summary>Whether the layout with row <paramref name="index"/> set to this kind and level is one random talismans roll.</summary>
    private bool Allowed(List<(string Kind, int Level)> rows, int index, string kind, int level)
    {
        var next = rows.ToList();
        next[index] = (kind, level);
        return Valid.Contains(Key(next));
    }

    private IReadOnlyList<SegmentOption<string>> KindOptions(List<(string Kind, int Level)> rows, int index) =>
        [KindOption(rows, index, Weapon, "Weapon slot: weapon decorations only", GameIcons.SlotWeapon), KindOption(rows, index, Armor, "Armor slot: armor decorations only", GameIcons.SlotArmor)];

    private SegmentOption<string> KindOption(List<(string Kind, int Level)> rows, int index, string kind, string hint, string icon)
    {
        // the kind needs a level that makes a layout random talismans roll (the row's own kind always stays clickable)
        var possible = Enumerable.Range(1, 3).Any(l => Allowed(rows, index, kind, l));
        return new SegmentOption<string>(kind, kind, Content: KindContent(kind, icon), Hint: possible ? hint : $"Random talismans do not roll another {kind} slot here",
            Disabled: !possible && rows[index].Kind != kind);
    }

    private static RenderFragment KindContent(string kind, string icon) => __builder =>
    {
        <span class="kind-choice"><img src="@icon" alt="" />@kind</span>
    };

    private IReadOnlyList<SegmentOption<int>> LevelOptions(List<(string Kind, int Level)> rows, int index)
    {
        var kind = rows[index].Kind;
        return Enumerable.Range(0, 4).Select(l =>
        {
            var ok = l == 0 || l == rows[index].Level || Allowed(rows, index, kind, l);
            return new SegmentOption<int>(l, l == 0 ? "×" : l.ToString(CultureInfo.InvariantCulture),
                Hint: l == 0 ? "No slot" : ok ? $"Level {l} {kind} slot" : $"Random talismans do not roll this layout", Disabled: !ok);
        }).ToList();
    }

    private Task SetLevel(int index, int level)
    {
        var rows = Rows();
        rows[index] = (rows[index].Kind, level);
        return Emit(rows);
    }

    private Task SetKind(int index, string kind)
    {
        var rows = Rows();
        if (rows[index].Level == 0)
        {
            _pending[index] = kind;
            StateHasChanged();
            return Task.CompletedTask;
        }
        // keep the level when that layout exists, else the highest level of the new kind that does
        var level = Allowed(rows, index, kind, rows[index].Level) ? rows[index].Level
            : Enumerable.Range(1, 3).Reverse().FirstOrDefault(l => Allowed(rows, index, kind, l));
        if (level == 0) return Task.CompletedTask;
        rows[index] = (kind, level);
        return Emit(rows);
    }

    private Task Emit(List<(string Kind, int Level)> rows)
    {
        var ordered = Ordered(rows);
        // rows without a slot move to the end; they start as armor again
        for (var i = 0; i < SlotCount; i++) _pending[i] = Armor;
        return ValueChanged.InvokeAsync(string.Join(",", ordered.Select(s => s.Kind + s.Level)));
    }
}
