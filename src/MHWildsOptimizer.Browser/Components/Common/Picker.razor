@typeparam T
@* A button that opens a searchable list (armor pieces, decorations, talismans). Arrow keys move, Enter picks, Escape closes. *@
<div class="picker-anchor @AnchorClass">
    <button type="button" class="picker-btn @Class @(_open ? "open" : "")" title="@Title" @onclick="Toggle" aria-haspopup="listbox" aria-expanded="@_open">
        @Trigger
    </button>
    @if (_open)
    {
        @* only while open: an editor has a few dozen pickers, and a popover each made every change to it slow. No MaxHeight:
           the body and its list are limited in app.css and only the list scrolls (a limit here scrolled the popover too) *@
        <MudPopover Open="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="picker-pop" Fixed="false">
            <div class="picker-pop-body" @onkeydown="OnKey">
                <MudTextField T="string" @ref="_search" Value="_query" ValueChanged="OnQuery" Immediate="true" Placeholder="@(Placeholder ?? "Search…")"
                              Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" />
                <div class="picker-list" role="listbox">
                    @if (OnClear.HasDelegate && _query.Length == 0)
                    {
                        <button type="button" class="picker-opt clear" @onclick="Clear">@(ClearLabel ?? "— none —")</button>
                    }
                    @if (_filtered.Count == 0)
                    {
                        <div class="muted picker-empty">Nothing matches “@_query”.</div>
                    }
                    @{ string? group = null; }
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var o = Options[_filtered[i]];
                        var index = i;
                        if (o.Group is not null && o.Group != group)
                        {
                            group = o.Group;
                            <div class="picker-group">@o.Group</div>
                        }
                        @* keyed by the position in Options: rows that stay while the query changes are kept as they are *@
                        <PickerRow @key="_filtered[i]" T="T" Option="o" Active="index == _active" OnHover="() => _active = index" OnPick="() => Pick(o)" />
                    }
                </div>
            </div>
        </MudPopover>
        <MudOverlay Visible="true" OnClick="Close" LockScroll="false" />
    }
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment Trigger { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PickerOption<T>> Options { get; set; } = [];
    [Parameter] public EventCallback<T> OnPick { get; set; }
    /// <summary>Offered as the first entry when given, e.g. to empty a slot.</summary>
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public string? ClearLabel { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Classes of the button (as the server client's className).</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Classes of the wrapper; "block" makes the button fill the width.</summary>
    [Parameter] public string? AnchorClass { get; set; }
    [Parameter] public string? Title { get; set; }

    private bool _open;
    private string _query = "";
    private int _active;
    private MudTextField<string>? _search;
    /// <summary>Indexes into <see cref="Options"/> of the entries that match the query, worked out when either changes.</summary>
    private List<int> _filtered = [];
    private IReadOnlyList<PickerOption<T>>? _filteredOptions;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_filteredOptions, Options)) Filter();
    }

    private void Filter()
    {
        _filteredOptions = Options;
        var words = _query.Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        _filtered = [];
        for (var i = 0; i < Options.Count; i++)
            if (words.All(w => Options[i].Search.Contains(w, StringComparison.Ordinal))) _filtered.Add(i);
    }

    private void Toggle()
    {
        if (_open) Close();
        else _open = true;
    }

    private void Close()
    {
        _open = false;
        _active = 0;
        if (_query.Length == 0) return;
        _query = "";
        Filter();
    }

    private void OnQuery(string value)
    {
        _query = value ?? "";
        _active = 0;
        Filter();
    }

    private async Task Pick(PickerOption<T> o)
    {
        Close();
        await OnPick.InvokeAsync(o.Value);
    }

    private async Task Clear()
    {
        Close();
        await OnClear.InvokeAsync();
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown": _active = Math.Min(_active + 1, _filtered.Count - 1); break;
            case "ArrowUp": _active = Math.Max(_active - 1, 0); break;
            case "Enter" when _active < _filtered.Count: await Pick(Options[_filtered[_active]]); break;
            case "Escape": Close(); break;
        }
    }
}
