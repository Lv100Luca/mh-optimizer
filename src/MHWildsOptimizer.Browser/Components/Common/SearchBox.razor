@* A search field that updates while typing. *@
<MudTextField T="string" Value="Value" ValueChanged="ValueChanged" Placeholder="@(Placeholder ?? "Search…")" Immediate="true"
              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Clearable="true" Class="@("searchbox " + Class)" />

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
}
