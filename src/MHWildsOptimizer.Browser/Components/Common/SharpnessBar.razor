@* The weapon's sharpness gauge; the reinforcement bonus is shown as text because the model only uses the top color. With
   Handicraft breakpoints, a hatched tail shows what Handicraft 5 adds to the top color. *@
@{
    var segments = new (SharpnessColor Color, int Value)[]
    {
        (SharpnessColor.Red, Bar.Red), (SharpnessColor.Orange, Bar.Orange), (SharpnessColor.Yellow, Bar.Yellow), (SharpnessColor.Green, Bar.Green),
        (SharpnessColor.Blue, Bar.Blue), (SharpnessColor.White, Bar.White), (SharpnessColor.Purple, Bar.Purple),
    };
    var extra = Handicraft is { Count: > 0 } h ? h.Sum() * 10 : 0;
    var top = segments.LastOrDefault(s => s.Value > 0).Color;
    var total = Math.Max(1, segments.Sum(s => s.Value) + extra);
}
<span class="sharpbar-wrap" title="@(string.Join(", ", segments.Where(s => s.Value > 0).Select(s => $"{s.Color.ToString().ToLowerInvariant()} {s.Value}")) + (extra > 0 ? $"; Handicraft 5: +{extra} {top.ToString().ToLowerInvariant()}" : ""))">
    <span class="sharpbar @Class">
        @foreach (var s in segments.Where(s => s.Value > 0))
        {
            <span class="seg" style="width: @((100.0 * s.Value / total).ToString("0.##", CultureInfo.InvariantCulture))%; background: @GameIcons.SharpnessCss[s.Color]"></span>
        }
        @if (extra > 0)
        {
            <span class="seg hc" style="width: @((100.0 * extra / total).ToString("0.##", CultureInfo.InvariantCulture))%; background: @GameIcons.SharpnessCss[top]"></span>
        }
    </span>
    @if (Bonus > 0)
    {
        <span class="muted small"> +@Bonus from reinforcements</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public SharpnessBarDto Bar { get; set; } = default!;
    [Parameter] public int Bonus { get; set; }
    /// <summary>The weapon's Handicraft breakpoints (the API's list); each level adds 10 hits to the top color.</summary>
    [Parameter] public IReadOnlyList<int>? Handicraft { get; set; }
    /// <summary>"big" for the full-width gauge of the weapon page, "compact" for table rows.</summary>
    [Parameter] public string? Class { get; set; }
}
