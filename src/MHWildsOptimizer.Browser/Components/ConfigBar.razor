@inherits AppComponent
@inject IDialogService Dialogs
@inject ProfileTransfer Transfer
@inject BrowserProfileStore BrowserStore
@inject IJSRuntime JS

@* Profile and weapon pickers, save / revert / delete, and the run button. Switching weapons keeps unsaved edits (they stay
   with their weapon, also across reloads), so there are no "discard?" questions here. *@
<div class="configbar">
    @* the profile's actions sit before its picker, away from the weapon controls (Delete profile is in there) *@
    <div class="configpick configprofile">
        <MudMenu @ref="_menu" Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" Dense="true" AriaLabel="Profile actions" title="Profile: new, import, export, delete"
                 AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            <MudMenuItem Icon="@Icons.Material.Filled.PersonAdd" OnClick="NewProfile">New profile…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.FileUpload" OnClick="Import">Import…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.FileDownload" OnClick="Export">Export @App.Profile</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever" OnClick="DeleteProfile">Delete @App.Profile…</MudMenuItem>
        </MudMenu>
        <MudSelect T="string" Value="App.Profile" ValueChanged="PickProfile" Label="Profile" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   Class="configsel" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" ToStringFunc="@(p => p)">
            @foreach (var p in App.Profiles)
            {
                <MudSelectItem Value="p.Name">@p.Name <span class="muted small">· @Fmt.Plural(p.Weapons, "weapon"), @Fmt.Plural(p.Talismans, "talisman")</span></MudSelectItem>
            }
        </MudSelect>
    </div>

    <span class="configdivider" aria-hidden="true"></span>

    <div class="configpick configweapon">
        <MudSelect T="string" Value="@(App.Name ?? NewKey)" ValueChanged="PickWeapon" Label="Weapon" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   Class="configsel" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" ToStringFunc="WeaponText">
            <MudSelectItem Value="@NewKey">
                <span class="weaponpick"><span class="weaponpick-new">+</span> New weapon@(App.Unsaved.Contains(AppState.NewWeapon) ? " (unsaved)" : "")</span>
            </MudSelectItem>
            @foreach (var w in App.Weapons.OrderBy(w => TypeOrder(w.Type)).ThenBy(w => w.Name, StringComparer.OrdinalIgnoreCase))
            {
                <MudSelectItem Value="w.Name">
                    <span class="weaponpick" title="@($"{TypeLabel(w.Type)}{(w.HasResults ? " · has a last run" : "")}")">
                        <img src="@GameIcons.Weapon(w.Type)" alt="" width="20" height="20" />
                        <span>@w.Name</span>
                        <span class="muted small">@TypeLabel(w.Type)@(App.Unsaved.Contains(w.Name) ? " · unsaved" : "")</span>
                    </span>
                </MudSelectItem>
            }
        </MudSelect>
    </div>

    @if (App.Dirty)
    {
        <span class="configname dirty" title="Unsaved changes are kept in this browser (also across reloads) until you save or revert them">unsaved<span class="configname-more"> changes</span></span>
    }

    <div class="btn-row configactions">
        <MudButton Variant="@(App.Dirty ? Variant.Filled : Variant.Outlined)" Color="@(App.Dirty ? Color.Primary : Color.Default)"
                   Size="Size.Small" Disabled="@(App.Name is not null && !App.Dirty)" OnClick="Save"
                   title="@(App.Name is { } n ? $"Save {n}" : "Save the new weapon under a name")">@(App.Name is null ? "Save…" : "Save")</MudButton>
        @if (App.Dirty)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Revert" Class="configbtn configicon-compact" StartIcon="@Icons.Material.Filled.Undo"
                       aria-label="Revert" title="Drop the unsaved changes"><span class="configbtn-label">Revert</span></MudButton>
        }
        @if (App.Name is { } name)
        {
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Weapon actions" title="@($"{name}: save as, delete")"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Filled.SaveAs" OnClick="SaveAs">Save as…</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="() => Delete(name)">Delete @name…</MudMenuItem>
            </MudMenu>
        }
    </div>

    @* when the top bar is short of room (app.css), these buttons show only their icon *@
    @if (App.Run.Status == RunStatus.Running)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="App.CancelRun" Class="configrun configbtn configicon-compact" StartIcon="@Icons.Material.Filled.Stop"
                   aria-label="Cancel run" title="Cancel the run"><span class="configbtn-label">Cancel run</span></MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(App.Resolved?.IsValid != true || App.Solver?.Problem is not null)" Class="configrun configbtn"
                   OnClick="App.RunOptimizerAsync" StartIcon="@Icons.Material.Filled.PlayArrow" aria-label="Run optimizer"
                   title="@(App.Solver?.Problem ?? (App.Resolved?.IsValid == true ? "Search for the best builds" : "Fix the validation errors first"))"><span class="configbtn-label">Run optimizer</span></MudButton>
    }
</div>

@code {
    private const string NewKey = "\u0000new";

    private MudMenu? _menu;

    /// <summary>A dialog opened from the menu renders above it while it is still closing: close it first.</summary>
    private Task CloseMenu() => _menu?.CloseMenuAsync() ?? Task.CompletedTask;

    private static string? NameError(string name) => ProfileRules.IsValidName(name) ? null : ProfileRules.NameRules;

    private async Task PickProfile(string profile)
    {
        if (profile != App.Profile) await App.OpenProfileAsync(profile);
    }

    private async Task PickWeapon(string value)
    {
        if (value == NewKey) { if (App.Name is not null) await App.NewWeaponAsync(); return; }
        if (value != App.Name) App.OpenWeapon(value);
    }

    private async Task NewProfile()
    {
        await CloseMenu();
        var name = await NameDialog.AskAsync(Dialogs, "New profile", "Profile name", ok: "Create",
            message: "A profile is an account with its own talismans, condition presets and weapons.",
            validate: n => NameError(n) ?? (App.Profiles.Any(p => p.Name.Equals(n, StringComparison.OrdinalIgnoreCase)) ? "That profile exists already." : null));
        if (name is not null) App.CreateProfile(name);
    }

    /// <summary>The picker's closed text: the weapon's name ("New weapon" for the unsaved one).</summary>
    private static string WeaponText(string value) => value == NewKey ? "New weapon" : value;

    private string TypeLabel(string kind) => Cat.WeaponTypes.GetValueOrDefault(kind)?.Label ?? Fmt.TitleCase(kind);

    /// <summary>Weapons grouped by type in the picker, in the order of the Weapon tab's type grid.</summary>
    private int TypeOrder(string kind)
    {
        var i = Catalog.WeaponTypes.ToList().FindIndex(t => t.Kind == kind);
        return i < 0 ? int.MaxValue : i;
    }

    /// <summary>Saves the open weapon; the new weapon has no name yet, so it asks for one.</summary>
    private Task Save() => App.Name is null ? SaveAs() : App.SaveAsync();

    /// <summary>A name that says what the weapon is ("Dragon Great Sword", "Great Sword 2"), not taken yet.</summary>
    private string SuggestedName()
    {
        var request = App.Request;
        if (request is null) return "My weapon";
        var kind = ProfileRules.WeaponKind(request);
        var element = request.Weapon.Spec?.Element ?? request.Weapon.Element;
        // weapon names allow letters, digits, spaces, '-', '_' and '.': "Sword & Shield" becomes "Sword and Shield"
        var label = new string(TypeLabel(kind).Replace("&", "and").Where(c => char.IsLetterOrDigit(c) || c is ' ' or '-' or '_' or '.').ToArray());
        var name = (element == Element.None ? "" : Fmt.TitleCase(element) + " ") + label;
        var taken = App.Weapons.Select(w => w.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!taken.Contains(name)) return name;
        for (var n = 2; ; n++)
            if (!taken.Contains($"{name} {n}")) return $"{name} {n}";
    }

    private async Task SaveAs()
    {
        var target = await NameDialog.AskAsync(Dialogs, App.Name is null ? "Save the new weapon" : "Save as", "Weapon name", App.Name is { } current ? $"{current} copy" : SuggestedName(), "Save",
            message: $"Saved in the profile {App.Profile}, in this browser.", validate: NameError);
        if (target is null) return;
        target = target.EndsWith(".json", StringComparison.OrdinalIgnoreCase) ? target[..^5] : target;
        if (App.Weapons.Any(w => w.Name == target) && target != App.Name && !await App.ConfirmAsync("Overwrite", $"Overwrite the existing weapon \"{target}\"?", "Overwrite"))
            return;
        await App.SaveAsync(target);
    }

    private async Task Revert()
    {
        if (await App.ConfirmAsync("Revert", App.Name is { } n ? $"Drop the unsaved changes of {n}?" : "Start the new weapon over?", "Revert")) App.Revert();
    }

    private async Task Delete(string name)
    {
        if (await App.ConfirmAsync("Delete weapon", $"Delete the weapon {name}, its builds and results?", "Delete")) App.Remove(name);
    }

    private async Task Import()
    {
        await CloseMenu();
        var parameters = new DialogParameters<ImportDialog>();
        var dialog = await Dialogs.ShowAsync<ImportDialog>("Import profile", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: string profile })
        {
            App.RefreshProfiles();
            await App.OpenProfileAsync(profile);
        }
    }

    private async Task Export()
    {
        if (App.Profile is not { } profile) return;
        var json = Transfer.Export(profile);
        await JS.InvokeVoidAsync("mhwo.download", $"{profile}.mhwo-profile.json", "application/json", json);
        App.Toast($"Exported {profile}: {Fmt.Plural(App.Weapons.Count, "weapon")}, {Fmt.Plural(App.Talismans.Count, "talisman")}");
    }

    private async Task DeleteProfile()
    {
        if (App.Profile is not { } profile) return;
        await CloseMenu();
        if (!await App.ConfirmAsync("Delete profile", $"Delete the profile {profile} with its {Fmt.Plural(App.Weapons.Count, "weapon")}, talismans and results from this browser? Export it first to keep a copy.", "Delete"))
            return;
        BrowserStore.DeleteProfile(profile);
        if (App.Profiles.Count <= 1) BrowserStore.CreateProfile("Default");
        App.RefreshProfiles();
        await App.OpenProfileAsync(App.Profiles.First(p => p.Name != profile).Name);
        App.Toast($"Deleted the profile {profile}");
    }
}
