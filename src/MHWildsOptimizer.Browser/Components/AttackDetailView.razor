@inject AppState App
@* One row of the damage-per-attack table taken apart: each hit (without a crit, with one, or averaged over the affinity, as
   Mode says), each sequence step with the conditions it changes, procs, and the calculator's trace. *@
@{
    var single = Detail.Steps.Count == 1 && Detail.Steps[0].Repeat == 1;
    var element = Element != Element.None;
}
<div class="attack-detail">
    @foreach (var note in Detail.Notes)
    {
        <p class="muted small">@note</p>
    }
    <table class="table attack-hits">
        <thead>
            <tr>
                <th>Hit</th>
                <th class="num narrow-hide">MV</th>
                <th class="num" title="@ModeTitle">@ModeLabel@(element ? " (raw + element)" : "")</th>
                <th class="num">Total</th>
            </tr>
        </thead>
        @for (var i = 0; i < Detail.Steps.Count; i++)
        {
            var step = Detail.Steps[i];
            <tbody @key="i">
                @if (!single || step.Conditions.Count > 0)
                {
                    <tr class="step-head">
                        <td colspan="4">
                            <span class="step-title">@(Detail.Steps.Count > 1 ? $"{i + 1}. " : "")@step.Name@(step.Repeat > 1 ? $" ×{step.Repeat}" : "")</span>
                            @foreach (var (key, on) in step.Conditions)
                            {
                                <span class="chip step-cond @(on ? "on" : "off")" title="Differs from the hunt conditions during this step">@Label(key): @(on ? "on" : "off")</span>
                            }
                            @if (StatsText(step) != StatsText(Detail.Steps[0]) || i == 0 && step.Conditions.Count > 0)
                            {
                                <span class="muted small step-stats">@StatsText(step)</span>
                            }
                        </td>
                    </tr>
                }
                @foreach (var h in step.Hits)
                {
                    <tr class="@(h.Shockwave ? "shockwave-row" : "")" title="@(h.Shockwave ? "A proc of the slash above: added to the total" : null)">
                        <td>
                            @(h.Shockwave ? "↳ " : "")@h.Name@(h.Count > 1 ? $" ×{h.Count}" : "")
                            @if (h.Notes.Count > 0)
                            {
                                <div class="muted tiny">@string.Join(" · ", h.Notes)</div>
                            }
                        </td>
                        <td class="num muted narrow-hide">@Fmt.N(h.Mv, 0)</td>
                        <td class="num">@Split(Raw(h), Ele(h), element)</td>
                        <td class="num"><b>@Fmt.N((Raw(h) + Ele(h)) * h.Count, 0)</b></td>
                    </tr>
                }
                @if (step.Procs > 0)
                {
                    <tr class="procs">
                        <td>@(step.ProcSources.Count > 0 ? string.Join(", ", step.ProcSources) : "Procs") <span class="muted small">per execution</span></td>
                        @Gap()
                        <td class="num"><b>@Fmt.N(step.Procs, 0)</b></td>
                    </tr>
                }
                @if (step.Repeat > 1)
                {
                    <tr class="procs">
                        <td class="muted small">×@step.Repeat</td>
                        @Gap()
                        <td class="num"><b>@Fmt.N(StepTotal(step), 0)</b></td>
                    </tr>
                }
            </tbody>
        }
        <tfoot>
            <tr>
                <td>
                    Total
                    @if (Mode != DamageMode.Average)
                    {
                        <span class="muted small">if every hit @(Mode == DamageMode.Crit ? "crits" : "lands without a crit"); the score counts the average, @Fmt.N(Detail.Total, 0)</span>
                    }
                </td>
                @Gap()
                <td class="num total-cell">@Fmt.N(Detail.Steps.Sum(StepTotal), 0)</td>
            </tr>
        </tfoot>
    </table>
    <p class="muted small">@StatsText(Detail.Steps[0])@(Detail.Steps.Any(x => StatsText(x) != StatsText(Detail.Steps[0])) ? "; steps with other stats say so" : "")</p>
    <details class="attack-trace">
        <summary>Every modifier</summary>
        <ul>
            @foreach (var line in Detail.Breakdown)
            {
                <li>@line</li>
            }
        </ul>
    </details>
</div>

@code {
    [Parameter, EditorRequired] public AttackDetailDto Detail { get; set; } = default!;
    [Parameter] public Element Element { get; set; }
    [Parameter] public DamageMode Mode { get; set; } = DamageMode.Average;

    private double Raw(HitDetailDto h) => Mode switch { DamageMode.NonCrit => h.Raw, DamageMode.Crit => h.RawCrit, _ => h.RawAverage };

    private double Ele(HitDetailDto h) => Mode switch { DamageMode.NonCrit => h.Element, DamageMode.Crit => h.ElementCrit, _ => h.ElementAverage };

    /// <summary>A step over all its repeats in the chosen mode (procs do not crit).</summary>
    private double StepTotal(AttackStepDamageDto s) => (s.Hits.Sum(h => (Raw(h) + Ele(h)) * h.Count) + s.Procs) * s.Repeat;

    private string ModeLabel => Mode switch { DamageMode.NonCrit => "Non-crit", DamageMode.Crit => "Crit", _ => "Average" };

    private string ModeTitle => Mode switch
    {
        DamageMode.NonCrit => "A hit without a critical hit",
        DamageMode.Crit => "A critical hit (the shockwave element does not crit)",
        _ => "Averaged over the affinity: what the score counts",
    };

    private string Label(string key) => App.Catalog.Conditions.FirstOrDefault(c => c.Key == key)?.Label ?? key;

    private string StatsText(AttackStepDamageDto s) =>
        $"raw {Fmt.N(s.TrueRaw, 0)} · affinity {s.Affinity}% (crit ×{Fmt.N(s.CritMultiplier, 2)})"
        + (Element != Element.None ? $" · {Fmt.TitleCase(Element)} {Fmt.N(s.ElementTrue, 0)} (crit ×{Fmt.N(s.CritElementMultiplier, 2)})" : "");

    /// <summary>The empty cells between a label and the total, matching the hit rows (MV hides on phones).</summary>
    private static RenderFragment Gap() => __builder =>
    {
        <td class="narrow-hide"></td>
        <td></td>
    };

    private static RenderFragment Split(double raw, double ele, bool element) => __builder =>
    {
        <span>@Fmt.N(raw + ele, 0)</span>
        @if (element && ele > 0)
        {
            <div class="muted tiny nowrap">@Fmt.N(raw, 0) + @Fmt.N(ele, 0)</div>
        }
    };
}
