@inherits AppComponent
@inject IDialogService Dialogs

@if (App.Request is { } request)
{
    var w = request.Weapon;
    var spec = w.Spec;
    var tree = w.TechTree is { } treeName ? Cat.TechTreeByName.GetValueOrDefault(treeName) : null;
    var mode = ModeOf(w);
    var kind = KindOf(w);
    var wt = Cat.WeaponTypes.GetValueOrDefault(kind);
    var resolved = App.Resolved;
    var weaponErrors = resolved?.Errors.Where(e => e.StartsWith("Weapon", StringComparison.Ordinal)).ToList() ?? [];
    var rw = resolved?.Weapon;
    var isBow = kind == "bow";
    var opt = request.WeaponOptimize;

    <div class="panel two-col">
        <div class="col">
            @{
                var pairOn = request.SkillPair.Mode == SkillPairMode.Optimize;
                var pool = Catalog.SkillPool;
                var showTypes = _showTypes || App.Name is null;
            }
            <Section Title="Weapon type" Hint="@(showTypes ? "A Gogma Artian weapon or a crafted one from the tech tree. Great Sword and Long Sword are fully modeled (core skills Focus 3 / Quick Sheathe 3, targets of every new one: see Targets & limits); other melee types run without core skills. The Bow scores charged shots, Power Shots and its coating; bowguns are out of scope." : null)">
                @if (showTypes)
                {
                    <div class="type-grid">
                        @foreach (var t in Catalog.WeaponTypes)
                        {
                            <button type="button" disabled="@(!t.Supported)" class="type-card @(t.Kind == kind ? "active" : "")" @onclick="() => SetType(t.Kind)"
                                    title="@(t.Supported ? $"{t.Label}: base attack {(t.Variants.GetValueOrDefault("attack")?.Raw.ToString(CultureInfo.InvariantCulture) ?? "?")} (attack focus)" : $"{t.Label}: out of scope")">
                                <img src="@(t.Supported ? GameIcons.Weapon(t.Kind) : GameIcons.WeaponBase(t.Kind))" alt="" />
                                <span>@t.Label</span>
                                @if (t.CoreSkills.Count > 0)
                                {
                                    <small>@string.Join(", ", t.CoreSkills.Select(c => $"{c.Skill} {c.Level}"))</small>
                                }
                            </button>
                        }
                    </div>
                    @if (_showTypes && App.Name is not null)
                    {
                        <button type="button" class="linklike small" @onclick="() => _showTypes = false">Keep the @(wt?.Label ?? kind)</button>
                    }
                }
                else
                {
                    <div class="type-chosen">
                        <img src="@GameIcons.Weapon(kind)" alt="" width="36" height="36" />
                        <b>@(wt?.Label ?? kind)</b>
                        @if (wt?.CoreSkills.Count > 0)
                        {
                            <span class="muted small">core skills @string.Join(", ", wt.CoreSkills.Select(c => $"{c.Skill} {c.Level}"))</span>
                        }
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _showTypes = true" title="Make this weapon another type (its conditions follow that type's preset, its starting targets that type's)">Change type</MudButton>
                    </div>
                }
            </Section>

            <Section Title="Stats"
                     Hint="@(mode switch
                     {
                         SpecMode => "Describe the Gogma Artian weapon the way the game shows it on the Production Bonus and Reinforcement Bonus screens; the true stats are computed. Switch on 'Let the optimizer choose' for a part you have not rolled yet or want to compare: it is then chosen per build, together with the armor.",
                         TreeMode => "A crafted weapon from the forge trees. Its attack, affinity, element, sharpness, slots and skills come from the game data; the skills count toward the build.",
                         _ => "Enter the final numbers from the equipment screen. A described weapon also lets the optimizer choose its parts.",
                     })">
                <Actions>
                    <Segmented T="string" Small="true" Value="mode" ValueChanged="SetMode" Options="ModeOptions" />
                </Actions>
                <ChildContent>
                    @if (mode == SpecMode && spec is not null)
                    {
                        <div class="form-grid">
                            <OptField Label="Focus" CanOptimize="true" Optimized="opt.Focus" OptimizedChanged="v => PatchOptimize(o => o with { Focus = v })"
                                      Hint="@(isBow ? "The Artian focus decides the base raw / affinity variant and the bow's coating: attack Close-range, affinity Power, element Pierce." : "The Artian focus decides the base raw / affinity variant.")">
                                <OptimizedContent>Attack, affinity and element focus each start a search with armor of their own, so the run takes up to three times as long. Each build shows how every focus does on its armor.</OptimizedContent>
                                <ChildContent>
                                    <Segmented T="GogmaFocus" Value="spec.Focus" ValueChanged="focus => PatchSpec(s => s with { Focus = focus })" Options="FocusOptions(wt)" />
                                    @if (isBow)
                                    {
                                        <p class="muted small">Coating: <b>@AttackProfile.CoatingName(Core.Gogma.GogmaConstants.BowCoatingOf(spec.Focus))</b> (from the @Fmt.TitleCase(spec.Focus) focus)</p>
                                    }
                                </ChildContent>
                            </OptField>

                            <OptField Label="Element" CanOptimize="@(wt?.Gunner != true || isBow)" Optimized="opt.Element" OptimizedChanged="v => PatchOptimize(o => o with { Element = v })">
                                <OptimizedContent>The five elements, always with the Element Infusion line: the target's hitzones decide.</OptimizedContent>
                                <ChildContent>
                                    <div class="chip-row">
                                        @foreach (var e in Elements)
                                        {
                                            <button type="button" class="chip pick @(spec.Element == e ? "active" : "")" style="--tint: @GameIcons.ElementCss[e]" @onclick="() => SetSpecElement(e)">
                                                @if (GameIcons.Element(e) is { } icon)
                                                {
                                                    <img src="@icon" alt="" />
                                                }
                                                @Fmt.TitleCase(e)
                                            </button>
                                        }
                                    </div>
                                </ChildContent>
                            </OptField>

                            <Field Label="Element Infusion line"
                                   Hint="@(wt is not null ? $"In the game a line under Production Bonus. It is there when all three Artian parts you crafted the weapon from share the element, and adds +{wt.InfusionBonusDisplay} element on top of the base {wt.ElementBaseDisplay}. Two matching parts give the element without the line." : null)">
                                <Toggle Checked="@((spec.Infused && spec.Element != Element.None) || opt.Element)" Disabled="@(spec.Element == Element.None || opt.Element)"
                                        CheckedChanged="infused => PatchSpec(s => s with { Infused = infused })"
                                        Label="@(opt.Element ? "Always on while the element is chosen per build" : spec.Element == Element.None ? "Needs an element" : "All three parts share the element")" />
                            </Field>

                            <OptField Label="Attack Infusion lines" CanOptimize="true" Optimized="opt.AttackParts" OptimizedChanged="v => PatchOptimize(o => o with { AttackParts = v })"
                                      Hint="Each Artian part gives +5 true attack or +5% affinity; count the 'Attack Infusion +5' lines under Production Bonus.">
                                <OptimizedContent>Every split of the three parts into +5 attack and +5% affinity is tried.</OptimizedContent>
                                <ChildContent>
                                    <Segmented T="int" Value="spec.AttackParts" ValueChanged="n => PatchSpec(s => s with { AttackParts = n })" Options="AttackPartOptions" />
                                </ChildContent>
                            </OptField>

                            <OptField Label="Reinforcement Bonus" Class="wide" CanOptimize="true" Optimized="opt.Reinforcements" OptimizedChanged="v => PatchOptimize(o => o with { Reinforcements = v })"
                                      Hint="@($"One row per line of the game's Reinforcement Bonus screen, top to bottom: pick the bonus, then its level. At most two identical lines, {(isBow ? "ammo" : "sharpness")} lines at most two in all; element lines need an element.")">
                                <OptimizedContent>
                                    <span>Every split of the five lines over @(isBow ? "attack, affinity and element" : "attack, affinity, element and sharpness") is tried, each type at its best tiers up to</span>
                                    <Segmented T="ReinforcementTier" Small="true" Value="opt.MaxTier" ValueChanged="t => PatchOptimize(o => o with { MaxTier = t })" Options="TierOptions" />
                                    <span>(at most two of a tier). EX lines are rare; III gives a weapon you can expect to roll.</span>
                                </OptimizedContent>
                                <ChildContent>
                                    @ReinforcementTable(spec, wt, kind)
                                </ChildContent>
                            </OptField>
                        </div>
                        @if (opt.Any)
                        {
                            <p class="muted small">@OptimizeSummary(opt)</p>
                        }
                    }

                    @if (mode == TreeMode)
                    {
                        <Field Label="Weapon" Hint="Pick it from the forge's tree, or search by name, tree, element, status or skill.">
                            <div class="trigger-row">
                                <div class="trigger-card">
                                    <img src="@GameIcons.Weapon(kind)" alt="" />
                                    <div class="tc-main">
                                        @if (tree is not null)
                                        {
                                            <b>@tree.Name <RarityBadge Rarity="tree.Rarity" /></b>
                                            <span>@TreeLabel(tree.Tree) tree · @tree.DisplayAttack@(tree.Element is { } e ? $" · {tree.ElementDisplay} {Fmt.TitleCase(e)}" : "")@(tree.Skills.Count > 0 ? " · " + string.Join(", ", tree.Skills.Select(g => $"{g.Skill} {g.Level}")) : "")</span>
                                        }
                                        else
                                        {
                                            <span class="err">@w.TechTree (unknown)</span>
                                        }
                                    </div>
                                    <button type="button" class="linklike small" @onclick="() => App.OpenWiki(Tab.WikiWeapons, w.TechTree)">wiki</button>
                                </div>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => ChooseFromTreeAsync(kind, w.TechTree)">Choose from the tree…</MudButton>
                                <Picker T="string" Class="btn sm" Options="TreeOptions(kind)" OnPick="name => App.PatchWeapon(x => x with { TechTree = name })"
                                        Placeholder="Search weapons, trees, elements, skills…">
                                    <Trigger>Search by name</Trigger>
                                </Picker>
                            </div>
                        </Field>
                        @if (tree?.Status is { } status)
                        {
                            <p class="muted small">Its @Fmt.TitleCase(status) (@tree.StatusDisplay) is not scored.</p>
                        }
                    }

                    @if (mode == StatsMode)
                    {
                        <div class="form-grid">
                            <Field Label="Attack">
                                <NumberInput T="int" Value="@TrueAttack(w, kind)" Min="1" Max="999" ValueChanged="attack => App.PatchWeapon(x => x with { Attack = attack, AttackIsDisplay = false })" />
                            </Field>
                            <Field Label="Affinity %">
                                <NumberInput T="int" Value="w.Affinity" Min="-100" Max="100" ValueChanged="affinity => App.PatchWeapon(x => x with { Affinity = affinity })" />
                            </Field>
                            <Field Label="Element">
                                <div class="chip-row">
                                    @foreach (var e in Elements)
                                    {
                                        <button type="button" class="chip pick @(w.Element == e ? "active" : "")" style="--tint: @GameIcons.ElementCss[e]"
                                                @onclick="() => App.PatchWeapon(x => x with { Element = e, ElementDisplay = e == Element.None ? 0 : x.ElementDisplay != 0 ? x.ElementDisplay : 300 })">
                                            @if (GameIcons.Element(e) is { } icon)
                                            {
                                                <img src="@icon" alt="" />
                                            }
                                            @Fmt.TitleCase(e)
                                        </button>
                                    }
                                </div>
                            </Field>
                            @if (w.Element != Element.None)
                            {
                                <Field Label="Element value">
                                    <NumberInput T="int" Value="w.ElementDisplay" Min="10" Max="9999" Step="10" ValueChanged="v => App.PatchWeapon(x => x with { ElementDisplay = v })" />
                                </Field>
                            }
                            @if (isBow)
                            {
                                <Field Label="Coating" Hint="The bow's damage coating, as the equipment screen lists it: every bow has one of Close-range, Power and Pierce.">
                                    <Segmented T="BowCoating" Value="@(w.Coating ?? BowCoating.Power)" ValueChanged="c => App.PatchWeapon(x => x with { Coating = c })" Options="CoatingOptions" />
                                </Field>
                            }
                            else
                            {
                                <Field Label="Sharpness the weapon attacks at">
                                    <Segmented T="SharpnessColor" Value="w.Sharpness" ValueChanged="c => App.PatchWeapon(x => x with { Sharpness = c })" Options="SharpnessOptions" />
                                </Field>
                            }
                            <Field Label="Decoration slots" Hint="Gogma weapons have three level-3 slots.">
                                <div class="chip-row">
                                    @for (var i = 0; i < 3; i++)
                                    {
                                        var index = i;
                                        <Segmented T="int" Small="true" Value="@(index < w.Slots.Count ? w.Slots[index] : 0)" ValueChanged="lv => SetSlot(index, lv)" Options="SlotOptions" />
                                    }
                                </div>
                            </Field>
                        </div>
                    }
                </ChildContent>
            </Section>

            @if (mode != TreeMode)
            {
                <Section Title="Rolled skill pair" Hint="The two lines under 'Active Skills' on the weapon: one set bonus and one group skill. The weapon counts as one armor piece for each.">
                    <Actions>
                        <span class="optfield-switch" title="@($"Search all {pool.Pairs.Count} rollable pairs ({pool.SetBonuses.Count} set bonuses × {pool.GroupSkills.Count} group skills), every pair equally likely")">
                            <MudSwitch T="bool" Value="pairOn" ValueChanged="SetPairOptimized" Color="Color.Primary" Size="Size.Small" Label="Let the optimizer choose" />
                        </span>
                    </Actions>
                    <ChildContent>
                        @if (pairOn)
                        {
                            <div class="optfield-note">
                                Every rollable pair is searched (@pool.Pairs.Count pairs; pairs that score the same under your conditions are searched once), so the pair below is not used.
                                @if (resolved?.SkillPairCandidates is { } c)
                                {
                                    <span> @Fmt.Plural(c, "candidate skill pair") will be searched.</span>
                                }
                            </div>
                            <Field Label="Best skill pairs to report" Inline="true">
                                <NumberInput T="int" Value="request.SkillPair.TopN" Min="1" Max="50" Width="90"
                                             ValueChanged="n => App.PatchRequest(r => r with { SkillPair = r.SkillPair with { TopN = n } })" />
                            </Field>
                        }
                        <div class="form-grid optfield-body" inert="@pairOn">
                            <Field>
                                <LabelContent><span class="with-icon"><SkillIcon Name="set" Kind="SkillKind.Set" /> Set bonus</span></LabelContent>
                                <ChildContent>
                                    <SearchSelect Value="@w.SetBonus" Placeholder="(none)" Options="@(Catalog.SkillPool.SetBonuses.Select(s => new SelectOption(s, s)).ToList())"
                                                  ValueChanged="v => App.PatchWeapon(x => x with { SetBonus = v })" />
                                </ChildContent>
                            </Field>
                            <Field>
                                <LabelContent><span class="with-icon"><SkillIcon Name="group" Kind="SkillKind.Group" /> Group skill</span></LabelContent>
                                <ChildContent>
                                    <SearchSelect Value="@w.GroupSkill" Placeholder="(none)" Options="@(Catalog.SkillPool.GroupSkills.Select(s => new SelectOption(s, s)).ToList())"
                                                  ValueChanged="v => App.PatchWeapon(x => x with { GroupSkill = v })" />
                                </ChildContent>
                            </Field>
                        </div>
                        @if (!pairOn && w.SetBonus is null && w.GroupSkill is null)
                        {
                            <p class="muted small">No rolled pair: the weapon adds no set bonus or group skill piece, as before its first reroll. Pick the two lines once you have them.</p>
                        }
                    </ChildContent>
                </Section>
            }
        </div>

        <aside class="col side sticky-side">
            <Section Title="Resolved weapon" Hint="What the optimizer will use (before any skills).">
                @foreach (var e in weaponErrors)
                {
                    <Alert Kind="error">@e</Alert>
                }
                @if (rw is not null)
                {
                    <div class="weapon-preview">
                        <div class="weapon-head">
                            <img src="@GameIcons.Weapon(rw.Type)" alt="" />
                            <div>
                                <div class="big">@(rw.Name ?? rw.Label)</div>
                                <div class="muted">@(rw.Name is not null ? $"{rw.Label} · rarity {rw.Rarity} tech tree" : $"{(rw.Focus is { } f ? $"{Fmt.TitleCase(f)} focus · " : "")}rarity 8 Gogma Artian")</div>
                            </div>
                        </div>
                        <dl class="stats">
                            <dt><img src="@GameIcons.Attack" alt="" /> Attack</dt>
                            <dd><b>@rw.TrueRaw</b></dd>
                            <dt><img src="@GameIcons.Affinity" alt="" /> Affinity</dt>
                            <dd><b>@(Fmt.Signed(rw.Affinity))%</b></dd>
                            <dt>
                                @if (GameIcons.Element(rw.Element) is { } elementIcon)
                                {
                                    <img src="@elementIcon" alt="" />
                                }
                                Element
                            </dt>
                            <dd>
                                @if (rw.Element == Element.None)
                                {
                                    <span class="muted">none</span>
                                }
                                else
                                {
                                    <b style="color: @GameIcons.ElementCss[rw.Element]">@rw.ElementDisplay @Fmt.TitleCase(rw.Element)</b>
                                }
                            </dd>
                            @if (rw.Coating is { } coating)
                            {
                                <dt>Coating</dt>
                                <dd><b>@AttackProfile.CoatingName(coating)</b></dd>
                            }
                            else
                            {
                                <dt><img src="@GameIcons.Sharpness" alt="" /> Sharpness</dt>
                                <dd>
                                    <b>@(rw.Sharpness is { } sharp ? Fmt.TitleCase(sharp) : "-")</b>
                                    @if (rw.SharpnessBar is { } bar)
                                    {
                                        <SharpnessBar Bar="bar" Bonus="rw.SharpnessBonus" />
                                    }
                                </dd>
                            }
                            <dt>Slots</dt>
                            <dd><Slots Numbers="rw.Slots" Kind="weapon" /></dd>
                            @if (rw.Name is not null)
                            {
                                <dt>Skills</dt>
                                <dd>
                                    @if (rw.Skills is { Count: > 0 } weaponSkills)
                                    {
                                        <GrantList Grants="weaponSkills" />
                                    }
                                    else
                                    {
                                        <span class="muted">none</span>
                                    }
                                </dd>
                                @if (rw.Status is { } status)
                                {
                                    <dt>Status</dt>
                                    <dd>@rw.StatusDisplay @Fmt.TitleCase(status) <span class="muted small">(not scored)</span></dd>
                                }
                            }
                            else
                            {
                                <dt>Rolled pair</dt>
                                <dd>
                                    @if (request.SkillPair.Mode == SkillPairMode.Optimize)
                                    {
                                        <span class="muted">optimized</span>
                                    }
                                    else
                                    {
                                        @if (rw.SetBonus is not null) { @rw.SetBonus } else { <span class="muted">no set bonus</span> }
                                        @(" / ")
                                        @if (rw.GroupSkill is not null) { @rw.GroupSkill } else { <span class="muted">no group skill</span> }
                                    }
                                </dd>
                            }
                        </dl>
                        @if (resolved?.Baseline is { } baseline)
                        {
                            <div class="baseline">
                                <span class="muted">Weapon-only baseline</span>
                                <b>EFR @Fmt.N(baseline.Efr)</b> + <b>EFE @Fmt.N(baseline.Efe)</b> = <b class="total">@Fmt.N(baseline.Total)</b>
                                <span class="muted"> under your conditions</span>
                            </div>
                        }
                    </div>
                }
                @if (rw is null && weaponErrors.Count == 0)
                {
                    <p class="muted">Validating…</p>
                }
            </Section>
        </aside>
    </div>
}

@code {
    private const string SpecMode = "spec";
    private const string StatsMode = "stats";
    private const string TreeMode = "tree";

    private static readonly Element[] Elements = Enum.GetValues<Element>();

    private static readonly IReadOnlyList<SegmentOption<string>> ModeOptions =
        [new(SpecMode, "Describe"), new(TreeMode, "Tech tree"), new(StatsMode, "Enter stats")];

    private static readonly IReadOnlyList<SegmentOption<int>> AttackPartOptions = [.. Enumerable.Range(0, 4).Select(n =>
        new SegmentOption<int>(n, n.ToString(CultureInfo.InvariantCulture), @<span>@n<small> +@(n * 5) atk · +@((3 - n) * 5)% aff</small></span>))];

    private static readonly IReadOnlyList<SegmentOption<BowCoating>> CoatingOptions =
        [.. Enum.GetValues<BowCoating>().Select(c => new SegmentOption<BowCoating>(c, AttackProfile.CoatingName(c)))];

    private static readonly IReadOnlyList<SegmentOption<int>> SlotOptions = [.. Enumerable.Range(0, 4).Select(n =>
        new SegmentOption<int>(n, n == 0 ? "—" : n.ToString(CultureInfo.InvariantCulture)))];

    private IReadOnlyList<SegmentOption<SharpnessColor>> SharpnessOptions => [.. Catalog.SharpnessColors.Select(name =>
    {
        var c = Enum.Parse<SharpnessColor>(name, ignoreCase: true);
        return new SegmentOption<SharpnessColor>(c, Fmt.TitleCase(c), @<span class="sharp-dot sharp-@name">@Fmt.TitleCase(c)</span>);
    })];

    private static IReadOnlyList<SegmentOption<GogmaFocus>> FocusOptions(WeaponTypeDto? wt) => [.. Enum.GetValues<GogmaFocus>().Select(f =>
    {
        var v = wt?.Variants.GetValueOrDefault(Fmt.Slug(f));
        return new SegmentOption<GogmaFocus>(f, Fmt.TitleCase(f), @<span>@Fmt.TitleCase(f)@if (v is not null) {<small> @v.Raw raw · @(Fmt.Signed(v.Affinity))%</small>}</span>);
    })];

    /// <summary>The attack the stats form shows, true raw: weapons entered before held the bloated number.</summary>
    private int TrueAttack(WeaponStatsInput w, string kind) =>
        w.AttackIsDisplay && w.Attack is { } attack && Cat.WeaponTypes.GetValueOrDefault(kind) is { Bloat: > 0 } t ? (int)Math.Round(attack / t.Bloat) : w.Attack ?? 0;

    private static string ModeOf(WeaponStatsInput w) => w.TechTree is not null ? TreeMode : w.Spec is not null ? SpecMode : StatsMode;

    /// <summary>A tech tree weapon keeps the spec or stats under it on its own type, so the kind follows from those too.</summary>
    private static string KindOf(WeaponStatsInput w) => w.Spec?.Type ?? w.Type ?? "great-sword";

    private string? DefaultTree(string kind) =>
        Cat.TechTreeByKind.GetValueOrDefault(kind)?.OrderByDescending(t => t.Rarity).ThenByDescending(t => t.Raw).First().Name;

    private static readonly Dictionary<string, List<PickerOption<string>>> TreeOptionsByKind = [];

    private List<PickerOption<string>> TreeOptions(string kind)
    {
        if (TreeOptionsByKind.TryGetValue(kind, out var cached)) return cached;
        return TreeOptionsByKind[kind] = [.. (Cat.TechTreeByKind.GetValueOrDefault(kind) ?? []).Select(t => new PickerOption<string>(t.Name, t.Name,
            string.Join(' ', [t.Name, t.Tree, t.Element?.ToString() ?? "", t.Status ?? "", .. t.Skills.Select(s => s.Skill)]),
            @<text>
                <img class="icon" src="@GameIcons.Weapon(t.Kind)" alt="" width="24" height="24" />
                <span class="opt-main">
                    <span class="opt-name">@t.Name</span>
                    <span class="muted small">@TreeStats(t)@(t.Skills.Count > 0 ? " · " + string.Join(", ", t.Skills.Select(g => $"{g.Skill} {g.Level}")) : "")</span>
                </span>
                <span class="opt-side">
                    <Slots Numbers="t.Slots" Kind="weapon" />
                    <RarityBadge Rarity="t.Rarity" />
                </span>
            </text>, TreeLabel(t.Tree)))];
    }

    /// <summary>"Arkveld Tree" as "Arkveld".</summary>
    private static string TreeLabel(string tree) => tree.EndsWith(" Tree", StringComparison.Ordinal) ? tree[..^5] : tree;

    /// <summary>"220 raw · +10% · 300 fire"</summary>
    private static string TreeStats(TechTreeWeapon t) =>
        string.Join(" · ", new[]
        {
            $"{t.Raw} raw",
            t.Affinity != 0 ? $"{Fmt.Signed(t.Affinity)}%" : null,
            t.Element is { } e ? $"{t.ElementDisplay} {Fmt.TitleCase(e)}" : null,
            t.Status is { } st ? $"{t.StatusDisplay} {Fmt.TitleCase(st)}" : null,
        }.OfType<string>());

    private void SetMode(string m)
    {
        var request = App.Request;
        if (request is null) return;
        var w = request.Weapon;
        var current = ModeOf(w);
        if (m == current) return;
        var kind = KindOf(w);
        if (m == TreeMode)
        {
            // no rolled pair and nothing to optimize on a crafted weapon
            App.PatchRequest(r => r with
            {
                Weapon = r.Weapon with { TechTree = DefaultTree(kind) },
                SkillPair = r.SkillPair with { Mode = SkillPairMode.Fixed },
                WeaponOptimize = r.WeaponOptimize with { Focus = false, Element = false, AttackParts = false, Reinforcements = false },
            });
            return;
        }
        if (current == TreeMode)
        {
            var tree = Cat.TechTreeByName.GetValueOrDefault(w.TechTree!);
            if (m == StatsMode && tree is not null)
            {
                var stats = WeaponStatsInput.FromTechTree(tree);
                if (w.Spec is not null) App.SetAsideSpec(w.Spec);
                App.PatchWeapon(x => x with
                {
                    TechTree = null,
                    Spec = null,
                    Type = kind,
                    Attack = tree.Raw,
                    AttackIsDisplay = false,
                    Affinity = tree.Affinity,
                    Element = tree.Element ?? Element.None,
                    ElementDisplay = tree.Element is null ? 0 : tree.ElementDisplay,
                    Sharpness = stats.TopSharpness ?? SharpnessColor.White,
                    Coating = stats.Coating,
                    Slots = [.. tree.Slots],
                });
                return;
            }
            App.PatchWeapon(x => x with { TechTree = null });
            w = App.Request!.Weapon;
            if (ModeOf(w) == m) return;
        }
        if (m == SpecMode)
        {
            var kept = App.TakeSetAsideSpec();
            App.PatchWeapon(x => x with
            {
                Spec = kept is not null && kept.Type == kind ? kept : new GogmaWeaponSpecInput
                {
                    Type = kind, Focus = GogmaFocus.Attack, Element = x.Element, Infused = x.Element != Element.None, AttackParts = 3, Reinforcements = [],
                },
                Type = null,
                Attack = null,
            });
        }
        else
        {
            var rw = App.Resolved?.Weapon;
            var variant = Cat.WeaponTypes.GetValueOrDefault(kind)?.Variants.GetValueOrDefault(Fmt.Slug(w.Spec?.Focus ?? GogmaFocus.Attack));
            if (w.Spec is not null) App.SetAsideSpec(w.Spec);
            App.PatchWeapon(x => x with
            {
                Spec = null,
                Type = kind,
                Attack = rw?.TrueRaw ?? variant?.Raw ?? 200,
                AttackIsDisplay = false,
                Affinity = rw?.Affinity ?? variant?.Affinity ?? 0,
                Element = x.Spec?.Element ?? Element.None,
                ElementDisplay = rw?.ElementDisplay ?? 0,
                Sharpness = SharpnessColor.White,
                Coating = kind == "bow" ? rw?.Coating ?? BowCoating.Power : null,
            });
        }
    }

    private static readonly IReadOnlyList<SegmentOption<ReinforcementTier>> TierOptions =
        [.. new[] { ReinforcementTier.EX, ReinforcementTier.III, ReinforcementTier.II }.Select(t => new SegmentOption<ReinforcementTier>(t, t.ToString()))];

    /// <summary>The type grid of a saved weapon, opened with "Change type".</summary>
    private bool _showTypes;

    private static readonly ReinforcementTier[] Tiers = Enum.GetValues<ReinforcementTier>();

    /// <summary>
    /// The Reinforcement Bonus screen the way the game lists it, five rows top to bottom: the bonus, its level and value as the
    /// game prints them ("Boost EX +10"), and the level buttons. At most two identical lines, sharpness or ammo two in all;
    /// element lines only with an element.
    /// </summary>
    private RenderFragment ReinforcementTable(GogmaWeaponSpecInput spec, WeaponTypeDto? wt, string kind) => __builder =>
    {
        var lines = spec.Reinforcements.Select(Line).ToList();
        var rowsKey = string.Join(",", spec.Reinforcements);
        var types = Catalog.Reinforcements.Where(r => (wt?.Gunner == true ? !r.MeleeOnly : !r.GunnerOnly) && (!r.NeedsElement || spec.Element != Element.None))
            .Select(r => r.Type).Distinct().ToList();
        <div class="rf-wrap">
            <div class="rf-table">
                @for (var i = 0; i < Core.Gogma.GogmaConstants.ReinforcementSlots; i++)
                {
                    var index = i;
                    var line = i < lines.Count ? lines[i] : null;
                    var others = lines.Where((_, j) => j != index).OfType<ReinforcementOptionDto>().ToList();
                    var options = types.Where(t => line?.Type == t || others.Count(o => o.Type == t) < Core.Gogma.GogmaConstants.MaxReinforcementsOfType(t))
                        .Select(t => new SelectOption(Fmt.Slug(t), Fmt.TitleCase(t))).ToList();
                    <div class="rf-row @(line is null ? "rf-empty" : "")">
                        <span class="rf-bonus">
                            @if (line is not null && BonusIcon(line.Type, spec.Element) is { } icon)
                            {
                                <img src="@icon" alt="" />
                            }
                            else
                            {
                                <span class="rf-icon"></span>
                            }
                            @* keyed on all lines: a pick that moves the rows (Empty) or lands on another row leaves this row's value as it was, and MudSelect would keep showing the pick *@
                            <SelectBox @key="@($"{index}:{rowsKey}")" Value="@(line is null ? null : Fmt.Slug(line.Type))" Placeholder="Empty" Options="options" ValueChanged="v => SetLineType(index, v)" />
                        </span>
                        @if (line is null)
                        {
                            <span class="rf-potency muted">—</span>
                            <span></span>
                        }
                        else
                        {
                            <span class="rf-potency"><span>Boost @line.Tier</span><b>+@BonusValue(line.Type, line.Tier, kind)</b></span>
                            <Segmented T="ReinforcementTier" Small="true" Value="line.Tier" ValueChanged="t => SetLineTier(index, t)" Options="TierChoices(line.Type, others, kind)" />
                        }
                    </div>
                }
            </div>
        </div>
        @if (spec.Reinforcements.Count > 0)
        {
            <button type="button" class="linklike small rf-clear" @onclick="() => PatchSpec(s => s with { Reinforcements = [] })">Clear all lines</button>
        }
    };

    /// <summary>A Reinforcement Bonus line from its input form ("attack EX"); null when it cannot be read.</summary>
    private ReinforcementOptionDto? Line(string text) => Catalog.Reinforcements.FirstOrDefault(r => r.Value.Equals(text, StringComparison.OrdinalIgnoreCase));

    private string LineValue(ReinforcementType type, ReinforcementTier tier) => Catalog.Reinforcements.First(r => r.Type == type && r.Tier == tier).Value;

    /// <summary>The levels a bonus comes in; one already on two other rows is greyed.</summary>
    private static IReadOnlyList<SegmentOption<ReinforcementTier>> TierChoices(ReinforcementType type, List<ReinforcementOptionDto> others, string kind) =>
        [.. Tiers.Where(t => Core.Gogma.GogmaConstants.TierExists(type, t)).Select(t =>
        {
            var taken = others.Count(o => o.Type == type && o.Tier == t) >= Core.Gogma.GogmaConstants.MaxIdenticalReinforcements;
            return new SegmentOption<ReinforcementTier>(t, t.ToString(),
                Hint: taken ? $"Two other rows are {Fmt.TitleCase(type)} {t} already" : $"{Fmt.TitleCase(type)} Boost {t}: +{BonusValue(type, t, kind)}", Disabled: taken);
        })];

    /// <summary>The number the game prints after the line: true attack, affinity %, display element, sharpness points, ammo capacity.</summary>
    private static int BonusValue(ReinforcementType type, ReinforcementTier tier, string kind) => type switch
    {
        ReinforcementType.Attack => Core.Gogma.GogmaConstants.AttackReinforcement(tier),
        ReinforcementType.Affinity => Core.Gogma.GogmaConstants.AffinityReinforcement(tier),
        ReinforcementType.Element => Core.Gogma.GogmaConstants.ElementReinforcementDisplay(WeaponTypeInfo.FromApiKind(kind), tier),
        ReinforcementType.Sharpness => Core.Gogma.GogmaConstants.SharpnessReinforcement(tier),
        _ => Core.Gogma.GogmaConstants.AmmoReinforcement(tier),
    };

    private static string? BonusIcon(ReinforcementType type, Element element) => type switch
    {
        ReinforcementType.Attack => GameIcons.Attack,
        ReinforcementType.Affinity => GameIcons.Affinity,
        ReinforcementType.Element => GameIcons.Element(element),
        ReinforcementType.Sharpness => GameIcons.Sharpness,
        _ => null,
    };

    /// <summary>
    /// Sets the bonus of one row. The row keeps its level when the new bonus has it free, else takes the best free level below
    /// it (a new row the best one). An empty choice removes the row; the rows under it move up.
    /// </summary>
    private void SetLineType(int index, string? value) => PatchSpec(s =>
    {
        var list = s.Reinforcements.ToList();
        if (value is null)
        {
            if (index < list.Count) list.RemoveAt(index);
            return s with { Reinforcements = list };
        }
        var type = Enum.Parse<ReinforcementType>(value, ignoreCase: true);
        var current = index < list.Count ? Line(list[index])?.Tier : null;
        var others = list.Where((_, j) => j != index).Select(Line).ToList();
        var free = Tiers.Where(t => Core.Gogma.GogmaConstants.TierExists(type, t)
                                    && others.Count(o => o?.Type == type && o.Tier == t) < Core.Gogma.GogmaConstants.MaxIdenticalReinforcements).ToList();
        if (free.Count == 0) return s;
        var below = free.Where(t => t <= (current ?? ReinforcementTier.EX)).ToList();
        var text = LineValue(type, below.Count > 0 ? below.Max() : free.Min());
        if (index < list.Count) list[index] = text;
        else list.Add(text);
        return s with { Reinforcements = list };
    });

    private void SetLineTier(int index, ReinforcementTier tier) => PatchSpec(s =>
    {
        if (index >= s.Reinforcements.Count || Line(s.Reinforcements[index]) is not { } line) return s;
        var list = s.Reinforcements.ToList();
        list[index] = LineValue(line.Type, tier);
        return s with { Reinforcements = list };
    });

    /// <summary>"Searches 3 foci x 5 elements x 46 reinforcement splits = 690 weapons for every build."</summary>
    private static string OptimizeSummary(Core.Gogma.WeaponOptimizeSettings o)
    {
        var parts = new List<(string Label, int Count)>();
        if (o.Focus) parts.Add(("foci", 3));
        if (o.Element) parts.Add(("elements", 5));
        if (o.AttackParts) parts.Add(("part splits", 4));
        var total = parts.Aggregate(1, (n, p) => n * p.Count);
        var text = string.Join(" × ", parts.Select(p => $"{p.Count} {p.Label}"));
        if (o.Reinforcements) text += (text.Length > 0 ? " × " : "") + "every split of the five reinforcement lines";
        return $"Tries {text} on every build found{(o.Reinforcements ? "" : $" ({total} weapons)")}, and searches the armor again for the weapon that wins until the two agree." +
               (o.Focus ? " Each focus starts a search of its own, so this takes up to three times as long." : "");
    }

    private void PatchOptimize(Func<Core.Gogma.WeaponOptimizeSettings, Core.Gogma.WeaponOptimizeSettings> fn) =>
        App.PatchRequest(r => r with { WeaponOptimize = fn(r.WeaponOptimize) });

    private void SetPairOptimized(bool on) =>
        App.PatchRequest(r => r with { SkillPair = r.SkillPair with { Mode = on ? SkillPairMode.Optimize : SkillPairMode.Fixed } });

    private void PatchSpec(Func<GogmaWeaponSpecInput, GogmaWeaponSpecInput> fn) =>
        App.PatchWeapon(w => w.Spec is { } spec ? w with { Spec = fn(spec) } : w);

    private async Task ChooseFromTreeAsync(string kind, string? current)
    {
        var name = await TechTreeDialog.ShowAsync(Dialogs, kind, current);
        if (name is not null) App.UseTechTreeWeapon(name, kind);
    }

    private void SetType(string kind)
    {
        _showTypes = false;
        if (App.Request?.Weapon is not { } w) return;
        if (w.Spec is not null) PatchSpec(s => s with { Type = kind });
        else App.PatchWeapon(x => x with { Type = kind, Coating = kind == "bow" ? x.Coating : null });
        if (w.TechTree is not null) App.PatchWeapon(x => x with { TechTree = DefaultTree(kind) });
    }

    /// <summary>Element "none" drops the infusion and the element reinforcements.</summary>
    private void SetSpecElement(Element e) => PatchSpec(s => s with
    {
        Element = e,
        Infused = e != Element.None && s.Infused,
        Reinforcements = e == Element.None ? s.Reinforcements.Where(r => !r.StartsWith("element", StringComparison.OrdinalIgnoreCase)).ToList() : s.Reinforcements,
    });

    private void SetSlot(int index, int level) => App.PatchWeapon(w =>
    {
        var slots = Enumerable.Range(0, Math.Max(3, w.Slots.Count)).Select(i => i < w.Slots.Count ? w.Slots[i] : 0).ToArray();
        slots[index] = level;
        return w with { Slots = slots.Where(x => x > 0).ToList() };
    });
}
