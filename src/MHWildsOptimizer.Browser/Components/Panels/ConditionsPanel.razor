@inherits AppComponent

@if (App.Request is { } request)
{
    var c = request.Conditions;
    var profile = c.AttackProfile ?? new AttackProfile();
    var preset = AttackProfilePreset(request, Cat);
    var kind = Kind(request);
    var type = TypeOf(request);
    var weapon = WeaponOf(request);
    var attackId = profile.Attack ?? preset.DefaultAttack ?? Attacks.Average;
    var attack = preset.Attacks.FirstOrDefault(a => a.Id == attackId);
    var resolved = weapon is not null ? c.Attack(weapon) : (ResolvedAttackProfile?)null;
    var element = weapon?.Element ?? request.Weapon.Spec?.Element ?? Element.None;
    var weaponLabel = Cat.WeaponTypes.GetValueOrDefault(kind)?.Label ?? kind;
    var hunt = Catalog.Conditions.Where(x => x.Group != ProcGroup).ToList();
    var procToggles = Catalog.Conditions.Where(x => x.Group == ProcGroup).ToList();
    var groups = hunt.Select(x => x.Group).Distinct().ToList();
    var onCount = hunt.Count(x => ConditionAccess.Get(c, x.Property));
    var profileErrors = App.Resolved?.Errors.Where(e => e.Contains("attack_profile") || e.Contains("conditions.target")).ToList() ?? [];
    var customProfile = IsCustom(profile);
    var target = c.Target ?? new Target();

    // the weapon type's preset: the conditions every weapon of this type starts from and follows, except where it overrides them
    var typePreset = App.PresetFor(kind);
    var hasPreset = App.Presets.ContainsKey(kind);
    var overridden = ConditionPresets.Overrides(c, typePreset);
    var weaponName = App.Name ?? "This weapon";
    var v = new View(c, typePreset, overridden, weaponLabel);

    <div class="panel">
        <Section Key="conditions-preset" Title="@($"{weaponLabel} preset")"
                 Hint="@($"Conditions are set per weapon type: every {weaponLabel} of the profile starts from this preset (hunt conditions, skill limits and attack profile). A weapon can override single values; the rest follows the preset when it changes.")">
            <Actions>
                <div class="btn-row">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="overridden.Count == 0" OnClick="() => ResetToPreset(typePreset)"
                               title="@($"Drop this weapon's overrides and use the {weaponLabel} preset")">Reset to preset</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="hasPreset && overridden.Count == 0" OnClick="() => ConfirmSavePreset(weaponLabel)"
                               title="@($"Make this weapon's conditions the {weaponLabel} preset")">Save as @weaponLabel preset</MudButton>
                </div>
            </Actions>
            <ChildContent>
                @if (!hasPreset)
                {
                    <p class="muted small">The profile has no @weaponLabel preset yet, so the defaults stand in. Set the conditions you usually play with and save them as the preset.</p>
                }
                @if (overridden.Count == 0)
                {
                    <p class="small"><span class="ok">✓</span> @weaponName follows the @weaponLabel preset.</p>
                }
                else
                {
                    <div class="chip-row">
                        <span class="muted small">@weaponName overrides:</span>
                        @foreach (var k in overridden)
                        {
                            <span @key="k" class="chip ovr-chip">@KeyLabel(k)</span>
                        }
                    </div>
                }
            </ChildContent>
        </Section>

        <Section Title="Hunt conditions"
                 Hint="A toggle only matters when a build actually carries the skill behind it: the calculator never invents a skill. Off means the skill scores nothing, so the optimizer will not chase it.">
            <Actions>
                <div class="btn-row">
                    <span class="muted small">@onCount of @hunt.Count on</span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => ApplyPreset(Catalog.ConditionsDefault)">Defaults</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => ApplyPreset(Catalog.ConditionsAllOn)">All on</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => ApplyPreset(Catalog.ConditionsAllOff)">All off</MudButton>
                </div>
            </Actions>
            <ChildContent>
                @foreach (var group in groups)
                {
                    <div @key="group" class="cond-group">
                        <h3>@group</h3>
                        <div class="cond-grid">
                            @foreach (var x in hunt.Where(x => x.Group == group))
                            {
                                @Condition(x, v)
                            }
                            @if (group == ConditionCatalog.GroupHunter)
                            {
                                <div class="cond resonance">
                                    <span class="cond-text">
                                        <b>Meal attack</b>
                                        <span class="muted small">The "Attack +N" of your meal's effects (0 without one). Flat, after the percentage bonuses.</span>
                                        <NumberInput T="int" Value="c.MealAttack" Min="0" Max="50" Width="90" ValueChanged="n => App.PatchConditions(x => x with { MealAttack = n })" />
                                    </span>
                                </div>
                            }
                            @if (group == ConditionCatalog.GroupBonuses)
                            {
                                <div class="cond resonance">
                                    <span class="cond-text">
                                        <b>Omega Resonance phase</b>
                                        <span class="muted small">Omega Resonance alternates a Local (affinity) and a Remote (attack) phase every 90 s.</span>
                                        <Segmented T="ResonanceMode" Small="true" Value="c.Resonance" ValueChanged="SetResonance" Options="ResonanceOptions" />
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </ChildContent>
        </Section>

        <Section Title="Attack and target"
                 Hint="The score is damage per 100 MV of the attack against the target, on the raw-hitzone-100 scale of EFR: every hit deals its MV of raw and its element modifier × element, and element counts at the target's element hitzone ÷ raw hitzone. Proc damage (Dark Arts shockwave, Bad Blood) is spread over the attack the same way.">
            <Actions>
                @if (customProfile)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => SetProfile(_ => new AttackProfile())">Back to the @weaponLabel default attack</MudButton>
                }
            </Actions>
            <ChildContent>
                @foreach (var e in profileErrors)
                {
                    <Alert Kind="error">@e</Alert>
                }
                <div class="attack-target">
                    <div class="attack-col">
                        <h3>Attack</h3>
                        @if (preset.Attacks.Count > 0)
                        {
                            <SelectBox Value="@attackId" Options="AttackOptions(preset)" ValueChanged="id => SetAttack(id, preset)" Style="max-width: 360px" />
                        }
                        @if (profile.IsSequence)
                        {
                            <p class="muted small">
                                Your rotation in order. Every step adds its hits; a step can change hunt conditions (e.g. Maximum Might off after a tackle used stamina),
                                and steps are weighted by their share of the motion value, so big finishers count most without dropping the hits before them.
                            </p>
                            <SequenceEditor Steps="profile.Sequence ?? []" Preset="preset" Base="c" StepsChanged="steps => SetProfile(p => p with { Sequence = steps.ToList() })" />
                        }
                        else if (attack is not null)
                        {
                            <p class="muted small">@attack.Description</p>
                            @HitTable(attack, weapon)
                        }
                        else
                        {
                            <p class="muted small">
                                Every hit counts as one element hit of the average motion value.
                                @(preset.Attacks.Count == 0 ? $"There is no attack data for the {weaponLabel} yet." : "")
                            </p>
                        }
                        <div class="form-grid profile">
                            <Field Label="Landed hits per minute" Hint="Cooldown-limited procs (Bad Blood every 2 s) fire at most once per cooldown. The default follows from the attack's rough duration.">
                                <OptionalNumberInput Value="profile.HitsPerMinute" Preset="Math.Round(resolved?.HitsPerMinute ?? preset.HitsPerMinute, 1)" Min="1" Max="600"
                                                     ValueChanged="n => SetProfile(p => p with { HitsPerMinute = n })" />
                            </Field>
                            @if (attack is null && !profile.IsSequence)
                            {
                                <Field Label="Average motion value per hit" Hint="Converts element and proc damage per hit into damage per 100 MV.">
                                    <OptionalNumberInput Value="profile.AverageMv" Preset="preset.AverageMv" Min="1" Max="1000"
                                                         ValueChanged="n => SetProfile(p => p with { AverageMv = n })" />
                                </Field>
                                <Field Label="Share of hits that are Lv3 charged slashes" Hint="Great Sword only: the Dark Arts shockwave (Soul of the Dark Knight) rides on them. 0 to 1.">
                                    <OptionalNumberInput Value="profile.ChargedLv3Share" Preset="preset.ChargedLv3Share" Min="0" Max="1" Step="0.05"
                                                         ValueChanged="n => SetProfile(p => p with { ChargedLv3Share = n })" />
                                </Field>
                            }
                        </div>
                    </div>

                    <div class="target-col">
                        <h3>Target</h3>
                        <Segmented T="TargetKind" Small="true" Value="target.Kind" ValueChanged="k => SetTargetKind(k, type)" Options="TargetKindOptions" />
                        @switch (target.Kind)
                        {
                            case TargetKind.Monster:
                                var monster = Catalog.Monsters.FirstOrDefault(m => m.Name == target.Monster);
                                <div class="target-pickers">
                                    <SearchSelect Value="@target.Monster" Placeholder="Pick a monster" Options="MonsterOptions" ValueChanged="m => SetMonster(m, type)" />
                                    @if (monster is not null)
                                    {
                                        <SelectBox Value="@target.Part" Options="PartOptions(monster, type, element)" ValueChanged="part => SetPart(monster, part, type)" />
                                    }
                                </div>
                                break;
                            case TargetKind.Dummy:
                                <Segmented T="string" Small="true" Value="@(target.Part ?? "")" ValueChanged="part => SetTarget(_ => Target.Dummy(part))"
                                           Options="@(Catalog.DummyTargets.Select(d => new SegmentOption<string>(d.Part!, d.Part!)).ToList())" />
                                <p class="muted small">Soft hide, no wounds. Hitzones read off community dummy tests; element assumed the same for every element.</p>
                                break;
                            default:
                                <div class="form-grid profile">
                                    <Field Label="Raw hitzone">
                                        <NumberInput T="double" Value="target.RawHitzone" Min="1" Max="200" ValueChanged="n => SetTarget(t => t with { RawHitzone = n })" />
                                    </Field>
                                    <Field Label="Element hitzone">
                                        <NumberInput T="double" Value="target.ElementHitzone" Min="0" Max="200" ValueChanged="n => SetTarget(t => t with { ElementHitzone = n })" />
                                    </Field>
                                </div>
                                break;
                        }
                        <p class="small target-line">
                            Raw hitzone <b>@Num(target.RawHitzone)</b>
                            · @(element == Element.None ? "element hitzone" : $"{Fmt.Slug(element)} hitzone") <b>@Num(target.ElementHitzoneFor(element))</b>
                            @if (element != Element.None)
                            {
                                <span> → element at <b>@Percent(target.ElementRatio(element))%</b> of raw</span>
                            }
                            · @(target.WeakPoint ? "weak point (45+): Weakness Exploit counts" : "not a weak point: Weakness Exploit does not count")
                        </p>
                    </div>
                </div>
                @if (resolved is { } rp)
                {
                    <p class="small attack-summary">
                        <b>@rp.Name</b>: @Num(Math.Round(rp.Hits, 2)) hits, @Num(Math.Round(rp.TotalMv, 1)) MV,
                        @Num(Math.Round(rp.ExecutionsPerMinute, 2)) per minute (results show its damage per @rp.Execution and per minute).
                        Per 100 MV: raw × @rp.RawFactor.ToString("0.###", CultureInfo.InvariantCulture) (sharpness@(type == WeaponType.SwitchAxe ? ", phial" : "")),
                        element × @rp.ElementFactor.ToString("0.###", CultureInfo.InvariantCulture) per true element point
                        (@((rp.ElementHitzoneRatio > 0 ? rp.ElementFactor / rp.ElementHitzoneRatio : 0).ToString("0.##", CultureInfo.InvariantCulture)) element hits per 100 MV, sharpness included, before the hitzone).
                    </p>
                }
                @if (procToggles.Count > 0)
                {
                    <div class="cond-grid">
                        @foreach (var x in procToggles)
                        {
                            @Condition(x, v)
                        }
                    </div>
                }
            </ChildContent>
        </Section>
    </div>
}

@code {
    /// <summary>The condition group that holds the proc damage toggle; it is rendered with the attack profile, not as a hunt condition.</summary>
    public const string ProcGroup = ConditionCatalog.GroupProcs;

    private static readonly AttackProfileDto FallbackProfile = new(40, 50, 0, null, [], []);

    private static readonly Dictionary<string, string> OtherLabels = new()
    {
        [nameof(Conditions.Resonance)] = "Omega Resonance phase",
        [nameof(Conditions.MealAttack)] = "Meal attack",
        [nameof(Conditions.AttackProfile)] = "Attack",
        [nameof(Conditions.Target)] = "Target",
        [nameof(Conditions.SkillLimits)] = "Skill limits",
    };

    private IReadOnlyList<SegmentOption<ResonanceMode>> ResonanceOptions => Catalog.ResonanceModes
        .Select(m => Enum.Parse<ResonanceMode>(m, ignoreCase: true))
        .Select(m => new SegmentOption<ResonanceMode>(m, m switch { ResonanceMode.None => "Off", ResonanceMode.Local => "Local (affinity)", _ => "Remote (attack)" }))
        .ToList();

    private static string Kind(OptimizationRequest r) => r.Weapon.Spec?.Type ?? r.Weapon.Type ?? "great-sword";

    private static bool IsCustom(AttackProfile p) => p.Attack is not null || p.HitsPerMinute is not null || p.AverageMv is not null || p.ChargedLv3Share is not null;

    private static WeaponType TypeOf(OptimizationRequest r)
    {
        try { return WeaponTypeInfo.FromApiKind(Kind(r)); }
        catch (ArgumentException) { return WeaponType.GreatSword; }
    }

    private Core.Gogma.GogmaWeaponStats? WeaponOf(OptimizationRequest r)
    {
        try { return r.Weapon.Validate(App.Data).Count == 0 ? r.Weapon.ToStats(App.Data) : null; }
        catch (Exception) { return null; }
    }

    private static IReadOnlyList<SelectOption> AttackOptions(AttackProfileDto preset) =>
        preset.Attacks.Select(a => new SelectOption(a.Id, a.Id == preset.DefaultAttack ? $"{a.Name} (default)" : a.Name, a.Combo ? "Combos" : "Moves"))
            .OrderBy(o => o.Group == "Combos")
            .Append(new SelectOption(Attacks.Sequence, "Custom sequence (your rotation)", "Other"))
            .Append(new SelectOption(Attacks.Average, "Average hit (motion value per hit)", "Other"))
            .ToList();

    private static readonly IReadOnlyList<SegmentOption<TargetKind>> TargetKindOptions =
    [
        new(TargetKind.Monster, "Monster"),
        new(TargetKind.Dummy, "Training dummy"),
        new(TargetKind.Custom, "Custom"),
    ];

    private IReadOnlyList<SelectOption> MonsterOptions => Catalog.Monsters.Select(m => new SelectOption(m.Name, m.Name)).ToList();

    private static IReadOnlyList<SelectOption> PartOptions(MonsterHitzones monster, WeaponType type, Element element) =>
        monster.Parts.Select(p =>
        {
            var t = Target.ForMonster(monster, p, type);
            var ele = element == Element.None ? "" : $" · {Fmt.Slug(element)} {Num(t.ElementHitzoneFor(element))}";
            return new SelectOption(p.Name, $"{p.Name} — raw {Num(t.RawHitzone)}{ele}");
        }).ToList();

    private void SetAttack(string? id, AttackProfileDto preset) =>
        SetProfile(p => p with
        {
            Attack = id is null || id == (preset.DefaultAttack ?? Attacks.Average) ? null : id,
            // a new sequence starts from the first example, or from the attack picked so far
            Sequence = id == Attacks.Sequence && p.Sequence is not { Count: > 0 }
                ? preset.Sequences.FirstOrDefault()?.Steps.ToList() ?? [new SequenceStep { Attack = p.Attack ?? preset.DefaultAttack ?? preset.Attacks[0].Id }]
                : p.Sequence,
        });

    private void SetTarget(Func<Target, Target> fn) => App.PatchConditions(c => c with { Target = fn(c.Target ?? new Target()) });

    private void SetTargetKind(TargetKind kind, WeaponType type) => SetTarget(t => t.Kind == kind ? t : kind switch
    {
        TargetKind.Dummy => Target.DummyParts[0],
        TargetKind.Monster when Catalog.Monsters.Count > 0 => Target.ForMonster(Catalog.Monsters[0], Catalog.Monsters[0].Parts[0], type),
        // a custom target starts from the numbers of the current one
        _ => new Target { RawHitzone = t.RawHitzone, ElementHitzone = t.Elements is null ? t.ElementHitzone : Target.DefaultElementHitzone },
    });

    private void SetMonster(string? name, WeaponType type)
    {
        if (Catalog.Monsters.FirstOrDefault(m => m.Name == name) is { } m && m.Parts.Count > 0)
            SetTarget(_ => Target.ForMonster(m, m.Parts[0], type));
    }

    private void SetPart(MonsterHitzones monster, string? part, WeaponType type)
    {
        if (monster.Parts.FirstOrDefault(p => p.Name == part) is { } p)
            SetTarget(_ => Target.ForMonster(monster, p, type));
    }

    private static RenderFragment HitTable(AttackDto attack, Core.Gogma.GogmaWeaponStats? weapon) => __builder =>
    {
        var phial = weapon?.Type == WeaponType.SwitchAxe ? Attacks.PhialOf(weapon.Focus, weapon.Element) : (SwitchAxePhial?)null;
        <table class="table hits">
            <thead><tr><th>Hit</th><th class="num">MV</th><th class="num">Element</th><th>Notes</th></tr></thead>
            <tbody>
                @foreach (var h in attack.Hits)
                {
                    var ele = phial == SwitchAxePhial.Element && h.ElementPhialElement is { } ep ? ep : h.Element;
                    var notes = new List<string>();
                    if (h.PowerMv is { } pmv) notes.Add($"{Num(pmv)} MV on a weak spot");
                    if (h.FixedSharpness is { } fs) notes.Add($"{Fmt.Slug(fs)} sharpness");
                    if (h.SwordMode && phial is { } ph) notes.Add(ph == SwitchAxePhial.Power ? $"raw ×{Num(DamageConstants.PowerPhialRaw)} (Power phial)" : $"element ×{Num(DamageConstants.ElementPhialElement)} (Element phial)");
                    if (h.ElementPhialElement is { } epx && phial is null) notes.Add($"element ×{Num(epx)} with an Element phial");
                    <tr>
                        <td>@h.Name@(h.Count > 1 ? $" ×{h.Count}" : "")</td>
                        <td class="num">@Num(h.Mv)</td>
                        <td class="num">×@Num(ele)</td>
                        <td class="muted small">@string.Join("; ", notes)</td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private static string Num(double n) => n.ToString(CultureInfo.InvariantCulture);

    private static string Percent(double share) => Math.Round(share * 100, MidpointRounding.AwayFromZero).ToString(CultureInfo.InvariantCulture);

    /// <summary>The attack profile preset of the request's weapon type.</summary>
    public static AttackProfileDto AttackProfilePreset(OptimizationRequest request, CatalogIndex index) =>
        index.WeaponTypes.GetValueOrDefault(Kind(request))?.AttackProfile ?? FallbackProfile;

    /// <summary>"True Charged Slash Lv3 · Rey Dau, Head (raw 60, element 20)": the attack and target the calculator will use.</summary>
    public static string AttackProfileText(OptimizationRequest request, CatalogIndex index)
    {
        var p = request.Conditions.AttackProfile ?? new AttackProfile();
        var preset = AttackProfilePreset(request, index);
        var id = p.Attack ?? preset.DefaultAttack ?? Attacks.Average;
        var attack = p.IsSequence
            ? $"sequence of {p.Sequence?.Sum(s => s.Repeat) ?? 0} attacks"
            : preset.Attacks.FirstOrDefault(a => a.Id == id)?.Name ?? $"average hit of {Num(p.AverageMv ?? preset.AverageMv)} MV";
        var t = request.Conditions.Target ?? new Target();
        var element = request.Weapon.Spec?.Element ?? Element.None;
        return $"{attack} · {t.Name} (raw {Num(t.RawHitzone)}, element {Num(t.ElementHitzoneFor(element))})";
    }

    /// <summary>What a condition card needs from the current render.</summary>
    private sealed record View(Conditions Current, Conditions TypePreset, IReadOnlyList<string> Overridden, string WeaponLabel);

    private RenderFragment Condition(ConditionDto x, View v) => __builder =>
    {
        var on = ConditionAccess.Get(v.Current, x.Property);
        var own = v.Overridden.Contains(x.Property);
        <label @key="x.Key" class="cond @(on ? "on" : "") @(own ? "overridden" : "")">
            <input type="checkbox" checked="@on" @onchange="e => Set(x.Property, e.Value is true)" />
            <span class="cond-text">
                <b>
                    @x.Label
                    @if (own)
                    {
                        <span class="ovr" title="@($"The {v.WeaponLabel} preset has this {(ConditionAccess.Get(v.TypePreset, x.Property) ? "on" : "off")}; this weapon overrides it.")">override</span>
                    }
                </b>
                <span class="muted small">@x.Description</span>
                <span class="cond-skills">
                    @foreach (var s in x.Skills)
                    {
                        var bare = SkillSuffix.Replace(s, "");
                        var skill = Cat.SkillsByName.GetValueOrDefault(bare);
                        <SkillHover @key="s" Name="@bare" Class="@($"chip skill {(skill?.Kind ?? SkillKind.Armor).ToString().ToLowerInvariant()} tiny")">
                            <SkillIcon Name="@bare" Kind="skill?.Kind" Size="14" />@s
                        </SkillHover>
                    }
                </span>
            </span>
        </label>
    };

    private string KeyLabel(string property) =>
        Catalog.Conditions.FirstOrDefault(x => x.Property == property)?.Label ?? OtherLabels.GetValueOrDefault(property) ?? property;

    private void Set(string property, bool value) => App.PatchConditions(c => ConditionAccess.With(c, property, value));

    private void SetResonance(ResonanceMode resonance) => App.PatchConditions(c => c with { Resonance = resonance });

    private void SetProfile(Func<AttackProfile, AttackProfile> fn) => App.PatchConditions(c => c with { AttackProfile = fn(c.AttackProfile ?? new AttackProfile()) });

    // presets only cover the hunt conditions: skill limits and the attack profile stay as they are
    private void ApplyPreset(Conditions preset) =>
        App.PatchConditions(c => AppState.Clone(preset) with { SkillLimits = c.SkillLimits, AttackProfile = c.AttackProfile });

    private void ResetToPreset(Conditions typePreset) => App.PatchConditions(_ => AppState.Clone(typePreset));

    private async Task ConfirmSavePreset(string weaponLabel)
    {
        if (await App.ConfirmAsync($"Save the {weaponLabel} preset",
                $"Save these conditions, skill limits and attack profile as the {weaponLabel} preset of {App.Profile}? New {weaponLabel} weapons start from it, and saved ones follow it except where they override it.",
                "Save"))
            App.SavePreset();
    }

    /// <summary>"Lord's Soul (Guts)" -> "Lord's Soul".</summary>
    private static readonly System.Text.RegularExpressions.Regex SkillSuffix = new(@"\s*\(.*\)$");
}
