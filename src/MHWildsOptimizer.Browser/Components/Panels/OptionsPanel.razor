@inherits AppComponent
@inject IJSRuntime JS

@if (App.Request is { } request)
{
    var o = request.Options;
    var excluded = o.ExcludeSets.ToHashSet();
    var cores = OptimizerOptions.ProcessorCount;
    var threads = o.MaxThreads;
    var threadPresets = new List<SegmentOption<int>> { new(0, $"All ({cores})", Hint: "every core of this browser") };
    if (cores >= 4) threadPresets.Add(new(cores / 2, "Half", Hint: $"{cores / 2} threads, leaves the rest for other work"));
    threadPresets.Add(new(1, "One", Hint: "single-threaded"));
    var isThreadPreset = threadPresets.Any(p => p.Value == threads);
    if (!isThreadPreset) threadPresets.Add(new(-1, "Custom", Hint: "custom value"));
    var listed = Catalog.ArmorSets.Where(s => s.Rarity >= o.MinRarity).ToList();
    var setStates = listed.ToDictionary(s => s.Name, s => SetState(o, s));
    var sets = LooseSearch.Filter(listed.Where(s => _setFilter == SetFilter.All || setStates[s.Name] == _setFilter),
        s => string.Join(' ', [s.Name, .. s.SetBonus, s.GroupSkill ?? "", .. s.Pieces.Select(p => p.Name)]), _query);
    var allowedSets = listed.Count(s => setStates[s.Name] != SetFilter.Off);
    var partlySets = listed.Count(s => setStates[s.Name] == SetFilter.Partly);
    var locked = o.LockedPieces(KindOf);
    var weaponName = App.Name ?? "the new weapon";
    var pairOptimized = request.SkillPair.Mode == SkillPairMode.Optimize;
    var perSolve = Math.Min(Core.Optimize.CpSatParameters.MaxWorkersPerSolve, cores);
    var lockWarnings = App.Resolved?.Warnings.Where(w => w.StartsWith("options.include_armor")).ToList() ?? [];
    var setWarnings = App.Resolved?.Warnings.Where(w => w.StartsWith("options.exclude_sets") || w.StartsWith("options.exclude_armor")).ToList() ?? [];

    <p class="scope-note small">
        These options belong to <b>@weaponName</b>: every weapon keeps its own. What the whole profile shares (talismans, the condition presets)
        has its own tabs; the storage of this browser is on <button type="button" class="linklike" @onclick="() => App.SetTab(Tab.Inventory)">Weapons</button>.
    </p>
    <div class="panel two-col">
        <div class="col">
            <Section Title="Search options">
                <div class="form-grid">
                    <Toggle Checked="o.AllowTranscendence" CheckedChanged="v => Patch(x => x with { AllowTranscendence = v })"
                            Label="Allow transcended slots" Hint="Armor Transcendence (HR 100+): rarity 5 armor gains +1 level on all three slot positions, rarity 6 on the first two." />
                    <Toggle Checked="request.Talismans.IncludeCraftable" CheckedChanged="v => App.PatchRequest(r => r with { Talismans = r.Talismans with { IncludeCraftable = v } })"
                            Label="@($"Include the {Catalog.CraftableTalismanCount} craftable charm lines")"
                            Hint="Every charm line at max rank (e.g. Challenger Charm III) next to your random talismans from the Talismans tab." />
                    <Field Label="Builds to report per skill pair" Inline="true">
                        <NumberInput T="int" Value="o.TopN" Min="1" Max="50" Width="90" ValueChanged="v => Patch(x => x with { TopN = v })" />
                    </Field>
                    <Field Label="Minimum armor rarity" Hint="Rarity 5 and 6 pieces are only worth it with transcendence; raise this to speed the search up.">
                        <Segmented T="int" Value="o.MinRarity" ValueChanged="v => Patch(x => x with { MinRarity = v })" Options="RarityOptions" />
                    </Field>
                    <Field Label="Search engine" Hint="Runs in this browser always use CP-SAT: it proves the best build for each skill pair (one solve per reported build) and keeps memory small. The beam search of the desktop version does not fit WebAssembly.">
                        <span><b>CP-SAT (exact)</b></span>
                    </Field>
                    <Field Label="Time limit per solve (s)" Inline="true" Hint="When a solve runs out of time the best build found so far is used and the result is no longer proven optimal.">
                        <NumberInput T="double" Value="o.CpSatTimeLimitSeconds" Min="1" Max="3600" Step="10" Width="90" ValueChanged="v => Patch(x => x with { CpSatTimeLimitSeconds = v })" />
                    </Field>
                    <Field Label="Time limit for builds 2 and on (s)" Inline="true"
                           Hint="The best build of each skill pair is proved optimal. The next ones get this long each: a solve that finishes in time is proved too, one that does not is ranked by the best build it found (usually the same, but not guaranteed). Set it as high as the limit above to prove every build.">
                        <NumberInput T="double" Value="o.CpSatRankTimeLimitSeconds" Min="1" Max="3600" Step="1" Width="90" ValueChanged="v => Patch(x => x with { CpSatRankTimeLimitSeconds = v })" />
                    </Field>
                    <Field Label="Threads" Hint="@($"CPU threads the search may use (this browser reports {cores} cores). One solve uses at most {perSolve} of them: more do not make a single solve faster. The rest solve skill pair classes side by side when the skill pair is optimized{(pairOptimized ? "" : "; with a rolled pair one solve runs at a time, so this run uses " + Math.Min(perSolve, threads <= 0 ? cores : threads))}. Results are identical for any count; fewer threads only take longer.")">
                        <div class="btn-row">
                            <Segmented T="int" Value="@(isThreadPreset ? threads : -1)" Options="threadPresets"
                                       ValueChanged="v => { if (v >= 0) Patch(x => x with { MaxThreads = v }); }" />
                            <NumberInput T="int" Value="threads" Min="0" Max="cores" Step="1" Width="70" ValueChanged="v => Patch(x => x with { MaxThreads = v })" />
                        </div>
                    </Field>
                </div>
            </Section>

        </div>

        <div class="col">
            <Section Key="allowed-armor" Title="@($"Locked armor ({o.IncludeArmor.Count})")"
                     Hint="Optimize around armor you wear: every run uses a locked piece for its kind, kinds without stay open. Lock pieces in the sets below, on a result or from a build.">
                <Actions>
                    @if (o.IncludeArmor.Count > 0)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => Patch(x => x with { IncludeArmor = [] })">Clear</MudButton>
                    }
                </Actions>
                <ChildContent>
                    @foreach (var w in lockWarnings)
                    {
                        <p @key="w" class="warn small">@w</p>
                    }
                    @if (App.Builds.Count > 0)
                    {
                        <div class="chip-row allow-from">
                            <span class="muted small">Use the armor of</span>
                            @foreach (var b in App.Builds)
                            {
                                <button @key="b" class="chip" title="Lock exactly the armor pieces of this build" @onclick="() => AllowBuild(b)">@b.Name</button>
                            }
                        </div>
                    }
                    <div class="allow-kinds">
                        @foreach (var k in Enum.GetValues<ArmorPieceKind>())
                        {
                            var pieces = o.IncludeArmor.Where(n => KindOf(n) == k).ToList();
                            <div @key="k" class="allow-kind">
                                <span class="muted small allow-kind-name">@k</span>
                                <span class="chip-row">
                                    @if (pieces.Count == 0)
                                    {
                                        <span class="muted small">any</span>
                                    }
                                    @foreach (var n in pieces)
                                    {
                                        var e = Cat.ArmorByName[n];
                                        <span @key="n" class="chip">
                                            <img src="@GameIcons.Armor(k, e.Rarity)" alt="" width="18" height="18" />@n
                                            <button class="linklike" title="Remove" @onclick="() => Unlock(n)">×</button>
                                        </span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </ChildContent>
            </Section>

            <Section Key="armor-sets" Title="@($"Allowed armor sets ({allowedSets}/{listed.Count})")"
                     Hint="Turn off sets or single pieces you do not own, e.g. event or collaboration gear. The pieces button picks single pieces. Only sets at or above the minimum rarity are listed.">
                <Actions>
                    @if (o.ExcludeSets.Count > 0 || o.ExcludeArmor.Count > 0)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => Patch(x => x with { ExcludeSets = [], ExcludeArmor = [] })">Allow all</MudButton>
                    }
                </Actions>
                <ChildContent>
                    @foreach (var w in setWarnings)
                    {
                        <p @key="w" class="warn small">@w</p>
                    }
                    <SearchBox Value="@_query" ValueChanged="v => _query = v ?? string.Empty" Placeholder="Search sets, pieces, set bonuses, group skills..." />
                    <div class="btn-row">
                        <Segmented T="SetFilter" Value="_setFilter" ValueChanged="v => _setFilter = v" Options="SetFilters" />
                        <span class="muted small">@allowedSets of @listed.Count allowed@(partlySets > 0 ? $", {partlySets} partly" : "")</span>
                    </div>
                    <div class="setlist" @ref="_setList">
                        @foreach (var s in sets)
                        {
                            <ArmorSetRow @key="s.Name" Set="s" Options="o" Locked="locked" KindOf="KindOf" OnPatch="Patch" />
                        }
                        @if (sets.Count == 0)
                        {
                            <p class="muted small allow-none">No sets match.</p>
                        }
                    </div>
                </ChildContent>
            </Section>
        </div>
    </div>
}

@code {
    private static readonly IReadOnlyList<SegmentOption<int>> RarityOptions = new[] { 5, 6, 7, 8 }
        .Select(r => new SegmentOption<int>(r, $"R{r}+", RarityLabel(r)))
        .ToList();

    private enum SetFilter { All, Off, Partly }

    private static readonly IReadOnlyList<SegmentOption<SetFilter>> SetFilters =
    [
        new(SetFilter.All, "All"),
        new(SetFilter.Off, "Disallowed", Hint: "sets with every piece turned off"),
        new(SetFilter.Partly, "Partly", Hint: "sets with some pieces turned off"),
    ];

    private string _query = "";
    private SetFilter _setFilter = SetFilter.All;
    private ElementReference _setList;

    private static RenderFragment RarityLabel(int r) =>
        @<span class="with-icon"><img src="@GameIcons.Armor(ArmorPieceKind.Chest, r)" alt="" width="18" height="18" /> R@(r)+</span>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (App.Request is null) return;
        try { await JS.InvokeVoidAsync("mhwo.syncMixed", _setList); }
        catch (JSException) { }
    }

    private void Patch(Func<OptimizerOptions, OptimizerOptions> fn) => App.PatchOptions(fn);

    private ArmorPieceKind? KindOf(string name) => Cat.ArmorByName.TryGetValue(name, out var e) ? e.Kind : null;

    // All doubles as "every piece allowed"
    private static SetFilter SetState(OptimizerOptions o, ArmorSetDto s)
    {
        var on = s.Pieces.Count(p => o.Allows(s.Name, p.Name));
        return on == s.Pieces.Count ? SetFilter.All : on == 0 ? SetFilter.Off : SetFilter.Partly;
    }

    private void Unlock(string name) => Patch(o => o with { IncludeArmor = o.IncludeArmor.Where(n => n != name).ToList() });

    /// <summary>Locks exactly the build's armor: every kind it wears is restricted to that piece.</summary>
    private void AllowBuild(BuildInput b) => Patch(o => o with
    {
        IncludeArmor = new[] { b.Head, b.Chest, b.Arms, b.Waist, b.Legs }.Where(a => a is not null).Select(a => a!.Piece).ToList(),
    });
}
