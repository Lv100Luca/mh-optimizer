@inherits AppComponent

@* Builds entered by hand (e.g. the one you wear), scored like the optimizer's and compared with its builds or each other. *@
@{
    var request = App.Request;
    var builds = App.Builds;
    var index = Math.Max(0, Math.Min(App.BuildIndex, builds.Count - 1));
    var current = builds.Count > 0 ? builds[index] : null;
    var ev = current is not null && App.Evaluated is { } evaluated && index < evaluated.Count ? evaluated[index] : null;
    var bestOptimizer = App.Run.Result?.Pairs.FirstOrDefault()?.Builds.FirstOrDefault();
}
@if (request is null)
{
    return;
}
@if (current is null)
{
    <div class="panel">
        <Section Title="My builds" Hint="Enter a build by hand, for example the one you wear, to score it under your conditions and compare it with the optimizer's builds.">
            <div class="empty">
                <p class="muted">The weapon is the one on the Weapon tab; you pick the armor, decorations and talisman.</p>
                <div class="btn-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewBuild">+ New build</MudButton>
                    @if (bestOptimizer is not null)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="() => StartFrom(bestOptimizer)">Start from optimizer build 1</MudButton>
                    }
                </div>
            </div>
        </Section>
    </div>
    return;
}
@{
    var b = ev?.Build;
    var met = ev?.Targets.Count(t => t.Met) ?? 0;
    var references = References(index);
    var reference = references.FirstOrDefault(r => r.Key == App.CompareKey) ?? references.FirstOrDefault();
    var scoredRef = reference?.Input is { } input ? Score(input) : null;
    var refBuild = reference is null ? null : reference.Input is not null ? scoredRef?.Build : reference.Build;
}
<div class="panel">
    <Section Title="My builds"
             Hint="Builds entered by hand are scored exactly like the optimizer's: same weapon (Weapon tab), conditions, skill limits and attack profile. They are saved with the weapon (in this browser); the picked one (★) represents the weapon in the inventory.">
        <Actions>
            <div class="btn-row">
                <MudButton Size="Size.Small" Variant="@(current.Picked ? Variant.Filled : Variant.Text)" Color="@(current.Picked ? Color.Primary : Color.Default)"
                           OnClick="() => App.PickBuild(current.Picked ? null : index)"
                           title="@(current.Picked ? "This is the weapon's pick: the inventory compares weapons by it. Click to unpick." : "Make this the weapon's pick: the inventory compares weapons by it")">
                    @(current.Picked ? "★ Picked" : "☆ Pick")
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="NewBuild">+ New</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Duplicate(current)">Duplicate</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Remove(current, index)">Delete</MudButton>
            </div>
        </Actions>
        <ChildContent>
            <div class="buildtabs" role="tablist">
                @for (var i = 0; i < builds.Count; i++)
                {
                    var x = builds[i];
                    var e = App.Evaluated is { } all && i < all.Count ? all[i] : null;
                    var tab = i;
                    <button type="button" role="tab" aria-selected="@(i == index)" class="buildtab @(i == index ? "active" : "")" @onclick="() => App.SetBuildIndex(tab)">
                        <span>@if (x.Picked) {<span class="pickstar" title="the weapon's pick">★ </span>}@(x.Name.Length > 0 ? x.Name : "(unnamed)")</span>
                        @if (e?.Build is { } eb) { <b>@Fmt.N(eb.Score)</b> } else { <span class="muted">…</span> }
                        @if (e is { Errors.Count: > 0 }) { <span class="err" title="@string.Join("\n", e.Errors)">!</span> }
                    </button>
                }
            </div>
            <div class="field inline">
                <span class="field-label">Name</span>
                <MudTextField T="string" Value="current.Name" ValueChanged="Rename" DebounceInterval="300"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="buildname" />
            </div>
        </ChildContent>
    </Section>

    <div class="scorebar">
        @if (b is not null)
        {
            <span class="scorebar-total"><span class="muted small">Score</span> <b>@Fmt.N(b.Score)</b></span>
            <span class="muted small">EFR @Fmt.N(b.Efr) + EFE @Fmt.N(b.Efe)@(b.Procs > 0 ? $" + procs {Fmt.N(b.Procs)}" : "")</span>
            <span class="statchip atk"><img src="@GameIcons.Attack" alt="" />ATK <b>@Fmt.N(b.Summary.Attack, 0)</b></span>
            <span class="statchip aff"><img src="@GameIcons.Affinity" alt="" />AFF <b>@b.Summary.Affinity%</b></span>
            @if (b.Summary.Element != Element.None)
            {
                <span class="statchip ele" style="--tint: @GameIcons.ElementCss[b.Summary.Element]">@Fmt.TitleCase(b.Summary.Element) <b>@Fmt.N(b.Summary.ElementTrue, 0)</b></span>
            }
            @if (ev is { Targets.Count: > 0 })
            {
                <span class="tcount @(met == ev.Targets.Count ? "ok" : "warn")">targets @met/@ev.Targets.Count</span>
            }
            @if (reference is not null && refBuild is not null)
            {
                <ScoreDelta Score="b.Score" Reference="refBuild.Score" Label="@reference.Label" />
            }
        }
        else
        {
            <span class="muted">@(ev is not null ? "Cannot score this build yet." : "Scoring…")</span>
        }
        @if (ev is { Errors.Count: > 0 })
        {
            <span class="err small right">@Fmt.Plural(ev.Errors.Count, "error")</span>
        }
    </div>

    <Section Title="Equipment" Hint="Pick each piece and the decorations in its slots. Pieces with better transcended slots (rarity 5/6) can be marked as transcended.">
        <EquipmentEditor Build="current" Update="Update" />
        @foreach (var e in ev?.Errors ?? [])
        {
            <Alert Kind="error">@e</Alert>
        }
        @foreach (var w in ev?.Warnings ?? [])
        {
            <Alert Kind="warning">@w</Alert>
        }
        @if (App.Resolved is { Weapon: null })
        {
            <Alert Kind="error">The weapon has errors. <button class="linklike" @onclick="() => App.SetTab(Tab.Weapon)">Open the Weapon tab</button></Alert>
        }
        @if (App.Talismans.Count == 0 && current.Talisman is null)
        {
            <p class="muted small">Your own random talismans come from the Talismans tab; craftable charms are always listed.</p>
        }
    </Section>

    @if (ev is { Targets.Count: > 0 })
    {
        <Section Title="Targets" Hint="The requirements of this configuration, checked against this build (the optimizer only returns builds that meet all of them).">
            <div class="chip-row">
                @foreach (var t in ev.Targets)
                {
                    var bonus = t.Kind is SkillKind.Set or SkillKind.Group;
                    <SkillHover Name="@t.Skill" Class="@("chip tcheck " + (t.Met ? "met" : "miss"))">
                        <SkillIcon Name="@t.Skill" Size="18" />
                        <span>@(t.Met ? "✓" : "✗") @t.Label</span>
                        @if (!t.Met)
                        {
                            <span class="muted small">has @t.Actual@(bonus ? $" piece{(t.Actual == 1 ? "" : "s")}" : "")</span>
                        }
                        @if (t.FromCore)
                        {
                            <span class="muted small">core skill</span>
                        }
                    </SkillHover>
                }
            </div>
        </Section>
    }

    <Section Title="Compare"
             Hint="@(reference?.Input is not null ? "The optimizer build is scored again under the current conditions, so both sides use the same assumptions." : "Differences are this build minus the other one; green means this build is ahead.")">
        <Actions>
            @if (references.Count > 0)
            {
                <SelectBox Value="@reference?.Key" ValueChanged="key => App.SetCompareKey(key)" Style="min-width: 280px"
                           Options="@references.Select(r => new SelectOption(r.Key, r.Label + (r.RunScore is { } rs ? $" ({Fmt.N(rs)} in the run)" : r.Build is { } rb ? $" ({Fmt.N(rb.Score)})" : ""), r.Group)).ToList()" />
            }
        </Actions>
        <ChildContent>
            @if (reference is null)
            {
                <p class="muted">Run the optimizer or add a second build to have something to compare with.</p>
            }
            else
            {
                @foreach (var e in scoredRef?.Errors ?? [])
                {
                    <Alert Kind="error">@reference.Label: @e</Alert>
                }
                @if (reference.RunScore is { } runScore && refBuild is not null && Math.Abs(refBuild.Score - runScore) > 0.05)
                {
                    <Alert Kind="info">The run scored @reference.Label at @Fmt.N(runScore); under the current conditions it scores @Fmt.N(refBuild.Score). Run the optimizer again after changing conditions.</Alert>
                }
                @if (b is not null && refBuild is not null)
                {
                    <BuildCompare A="b" ALabel="@(current.Name.Length > 0 ? current.Name : "This build")" B="refBuild" BLabel="@reference.Label" />
                }
                else if (scoredRef is not { Errors.Count: > 0 })
                {
                    <p class="muted">Scoring…</p>
                }
            }
        </ChildContent>
    </Section>

    @if (b is not null)
    {
        <BuildCard Build="b" Title="@(current.Name.Length > 0 ? current.Name : "This build")" Compact="true" />
    }
</div>

@code {
    /// <summary>Something to compare the selected build with: an optimizer build (scored again under the current request) or another of your builds.</summary>
    private sealed record Reference(string Key, string Label, string Group, BuildInput? Input, BuildDto? Build, double? RunScore = null);

    private List<Reference> References(int index)
    {
        var refs = new List<Reference>();
        var pairs = App.Run.Result?.Pairs ?? [];
        foreach (var p in pairs)
            foreach (var build in p.Builds)
            {
                var label = pairs.Count > 1 ? $"Pair #{p.Rank} build {build.Rank}" : $"Optimizer build {build.Rank}";
                refs.Add(new Reference($"opt:{p.Rank}:{build.Rank}", label, "Optimizer results", BuildHelpers.FromBuild(build, label), null, build.Score));
            }
        for (var i = 0; i < App.Builds.Count; i++)
            if (i != index)
                refs.Add(new Reference($"mine:{i}", App.Builds[i].Name, "My builds", null, App.Evaluated is { } e && i < e.Count ? e[i].Build : null));
        return refs;
    }

    // the optimizer build being compared, scored under the current request (cached until the request, talismans or build change)
    private (OptimizationRequest? Request, IReadOnlyList<TalismanInput>? Talismans, string Key, EvaluatedBuildDto? Result) _scored;

    private EvaluatedBuildDto? Score(BuildInput input)
    {
        var key = System.Text.Json.JsonSerializer.Serialize(input, BrowserProfileStore.Json);
        if (ReferenceEquals(_scored.Request, App.Request) && ReferenceEquals(_scored.Talismans, App.Talismans) && _scored.Key == key) return _scored.Result;
        EvaluatedBuildDto? result;
        try
        {
            var payload = new ConfigPayload(App.Request!, App.Talismans.ToList(), [input]);
            result = BuildEvaluation.Evaluate(payload, Resolving.Resolve(payload, App.Data, App.Store.Directory), App.Data).FirstOrDefault();
        }
        catch (Exception e)
        {
            result = new EvaluatedBuildDto(input.Name, [$"Scoring failed: {e.Message}"], [], null, []);
        }
        _scored = (App.Request, App.Talismans, key, result);
        return result;
    }

    private void Update(Func<BuildInput, BuildInput> fn)
    {
        var index = Math.Max(0, Math.Min(App.BuildIndex, App.Builds.Count - 1));
        App.SetBuilds(list => list.Select((b, i) => i == index ? fn(b) : b).ToList());
    }

    private List<string> Names => App.Builds.Select(b => b.Name).ToList();

    private void NewBuild() => AddNew(BuildHelpers.Empty(BuildHelpers.UniqueName("My build", Names)));

    private void StartFrom(BuildDto optimizerBuild)
    {
        AddNew(BuildHelpers.FromBuild(optimizerBuild, "Optimizer build 1 (copy)"));
        App.SetCompareKey(null);
    }

    private void Duplicate(BuildInput current) => AddNew(AppState.Clone(current) with { Name = BuildHelpers.UniqueName(current.Name + " copy", Names), Picked = false });

    private void Rename(string? name) => Update(b => b with { Name = name ?? "" });

    private void AddNew(BuildInput build)
    {
        var count = App.Builds.Count;
        App.SetBuilds(list => [.. list, build]);
        App.SetBuildIndex(count);
    }

    private async Task Remove(BuildInput current, int index)
    {
        if (!await App.ConfirmAsync("Delete build", $"Delete the build \"{current.Name}\"?", "Delete")) return;
        App.SetBuilds(list => list.Where((_, i) => i != index).ToList());
        App.SetBuildIndex(Math.Max(0, index - 1));
        if (App.CompareKey?.StartsWith("mine:") == true) App.SetCompareKey(null);
    }
}
