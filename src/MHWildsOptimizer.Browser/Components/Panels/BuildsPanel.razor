@inherits AppComponent

@* Builds entered by hand (e.g. the one you wear), scored like the optimizer's and compared with its builds or each other. *@
@{
    var request = App.Request;
    var builds = App.Builds;
    var index = Math.Max(0, Math.Min(App.BuildIndex, builds.Count - 1));
    var current = builds.Count > 0 ? builds[index] : null;
    var ev = current is not null && App.Evaluated is { } evaluated && index < evaluated.Count ? evaluated[index] : null;
    var bestOptimizer = App.Run.Result?.Pairs.FirstOrDefault()?.Builds.FirstOrDefault();
}
@if (request is null)
{
    return;
}
@if (current is null)
{
    <div class="panel">
        <Section Title="My builds" Hint="Enter a build by hand, for example the one you wear, to score it under your conditions and compare it with the optimizer's builds.">
            <div class="empty">
                <p class="muted">The weapon is the one on the Weapon tab; you pick the armor, decorations and talisman.</p>
                <div class="btn-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewBuild">+ New build</MudButton>
                    @if (bestOptimizer is not null)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="() => StartFrom(bestOptimizer)">Start from optimizer build 1</MudButton>
                    }
                </div>
            </div>
        </Section>
    </div>
    return;
}
@{
    var b = ev?.Build;
    var met = ev?.Targets.Count(t => t.Met) ?? 0;
    var references = References(index);
    var reference = references.FirstOrDefault(r => r.Key == App.CompareKey) ?? references.FirstOrDefault();
    // an optimizer build is compared under this build's conditions
    var scoredRef = reference?.Input is { } input ? Score(input with { Conditions = current.Conditions, Resonance = current.Resonance, Target = current.Target }) : null;
    var refBuild = reference is null ? null : reference.Input is not null ? scoredRef?.Build : reference.Build;
}
<div class="panel">
    <Section Title="My builds"
             Hint="Builds entered by hand are scored exactly like the optimizer's: same weapon (Weapon tab), conditions, skill limits and attack profile. They are saved with the weapon (in this browser); the picked one (★) represents the weapon in the inventory.">
        <Actions>
            <div class="btn-row">
                <MudButton Size="Size.Small" Variant="@(current.Picked ? Variant.Filled : Variant.Text)" Color="@(current.Picked ? Color.Primary : Color.Default)"
                           OnClick="() => App.PickBuild(current.Picked ? null : index)"
                           title="@(current.Picked ? "This is the weapon's pick: the inventory compares weapons by it. Click to unpick." : "Make this the weapon's pick: the inventory compares weapons by it")">
                    @(current.Picked ? "★ Picked" : "☆ Pick")
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="NewBuild">+ New</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Duplicate(current)">Duplicate</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Remove(current, index)">Delete</MudButton>
            </div>
        </Actions>
        <ChildContent>
            <div class="buildtabs" role="tablist">
                @for (var i = 0; i < builds.Count; i++)
                {
                    var x = builds[i];
                    var e = App.Evaluated is { } all && i < all.Count ? all[i] : null;
                    var tab = i;
                    <button type="button" role="tab" aria-selected="@(i == index)" class="buildtab @(i == index ? "active" : "")" @onclick="() => App.SetBuildIndex(tab)">
                        <span>@if (x.Picked) {<span class="pickstar" title="the weapon's pick">★ </span>}@(x.Name.Length > 0 ? x.Name : "(unnamed)")</span>
                        @if (e?.Build is { } eb) { <b>@BuildDamage.Text(eb)</b> } else { <span class="muted">…</span> }
                        @if (x.HasOwnConditions) { <span class="ovr" title="Scored under its own conditions">own</span> }
                        @if (e is { Errors.Count: > 0 }) { <span class="err" title="@string.Join("\n", e.Errors)">!</span> }
                    </button>
                }
            </div>
            <div class="field inline">
                <span class="field-label">Name</span>
                <MudTextField T="string" Value="current.Name" ValueChanged="Rename" DebounceInterval="300"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="buildname" />
            </div>
        </ChildContent>
    </Section>

    <div class="scorebar">
        @if (b is not null)
        {
            @if (BuildDamage.Of(b) is { } damage)
            {
                <span class="scorebar-total" title="@($"Score: EFR {Fmt.N(b.Efr)} + EFE {Fmt.N(b.Efe)}{(b.Procs > 0 ? $" + procs {Fmt.N(b.Procs)}" : "")} = {Fmt.N(b.Score)} per 100 MV")"><b>@Fmt.N(damage, 0)</b> <span class="muted small">@BuildDamage.Label(b)</span></span>
            }
            else
            {
                <span class="scorebar-total"><span class="muted small">Score</span> <b>@Fmt.N(b.Score)</b></span>
                <span class="muted small">EFR @Fmt.N(b.Efr) + EFE @Fmt.N(b.Efe)@(b.Procs > 0 ? $" + procs {Fmt.N(b.Procs)}" : "")</span>
            }
            <span class="statchip atk"><img src="@GameIcons.Attack" alt="" />ATK <b>@Fmt.N(b.Summary.Attack, 0)</b></span>
            <span class="statchip aff"><img src="@GameIcons.Affinity" alt="" />AFF <b>@b.Summary.Affinity%</b></span>
            @if (b.Summary.Element != Element.None)
            {
                <span class="statchip ele" style="--tint: @GameIcons.ElementCss[b.Summary.Element]">@Fmt.TitleCase(b.Summary.Element) <b>@Fmt.N(b.Summary.ElementTrue, 0)</b></span>
            }
            @if (ev is { Targets.Count: > 0 })
            {
                <span class="tcount @(met == ev.Targets.Count ? "ok" : "warn")">targets @met/@ev.Targets.Count</span>
            }
            @if (reference is not null && refBuild is not null)
            {
                var (value, against, digits) = BuildDamage.Compare(b, refBuild);
                <ScoreDelta Score="value" Reference="against" Digits="digits" Label="@reference.Label" />
            }
        }
        else
        {
            <span class="muted">@(ev is not null ? "Cannot score this build yet." : "Scoring…")</span>
        }
        @if (ev is { Errors.Count: > 0 })
        {
            <span class="err small right">@Fmt.Plural(ev.Errors.Count, "error")</span>
        }
    </div>

    <Section Title="Equipment" Hint="Pick each piece and the decorations in its slots. Pieces with better transcended slots (rarity 5/6) can be marked as transcended.">
        <EquipmentEditor Build="current" Update="Update" />
        @foreach (var e in ev?.Errors ?? [])
        {
            <Alert Kind="error">@e</Alert>
        }
        @foreach (var w in ev?.Warnings ?? [])
        {
            <Alert Kind="warning">@w</Alert>
        }
        @if (App.Resolved is { Weapon: null })
        {
            <Alert Kind="error">The weapon has errors. <button class="linklike" @onclick="() => App.SetTab(Tab.Weapon)">Open the Weapon tab</button></Alert>
        }
        @if (App.Talismans.Count == 0 && current.Talisman is null)
        {
            <p class="muted small">Your own random talismans come from the Talismans tab; craftable charms are always listed.</p>
        }
    </Section>

    @if (b is not null)
    {
        var weaponConditions = request.Conditions;
        var effective = current.ConditionsFor(weaponConditions);
        bool Has(string name) => HasSkill(b, name);
        var relevant = ConditionCatalog.For(Catalog.Conditions, Has);
        var shown = (_allConditions ? Catalog.Conditions : relevant).ToList();
        var weaponTarget = weaponConditions.Target ?? new Target();
        var st = b.StatsRequested;
        var s = b.Summary;
        <Section Title="Conditions and stats of this build"
                 Hint="What is active for this build. Unset toggles follow the weapon's conditions (Conditions tab), so the optimizer's search is not affected: set them to score the build as you play it, or to match the game's status screen and training dummy. Only conditions whose skills this build carries are listed.">
            <Actions>
                <div class="btn-row">
                    <label class="check small" title="Also list conditions this build has no skill for">
                        <input type="checkbox" checked="@_allConditions" @onchange="e => _allConditions = e.Value is true" />
                        all conditions
                    </label>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="!current.HasOwnConditions" OnClick="() => Update(x => x.WithoutOwnConditions())"
                               title="Drop this build's own conditions and target">Follow the weapon's conditions</MudButton>
                </div>
            </Actions>
            <ChildContent>
                <div class="build-cond-layout">
                    <div class="build-conds">
                        @if (shown.Count == 0)
                        {
                            <p class="muted small">This build carries no conditional skill.</p>
                        }
                        <div class="cond-grid compact">
                            @foreach (var x in shown.Where(x => x.Group != ConditionsPanel.ProcGroup))
                            {
                                @BuildCondition(x, current, effective, weaponConditions)
                            }
                        </div>
                        @if (Has(SkillNames.OmegaResonance) || _allConditions)
                        {
                            <div class="cond-line">
                                <span class="muted small">Omega Resonance phase</span>
                                <Segmented T="ResonanceMode" Small="true" Value="effective.Resonance" ValueChanged="SetResonance" Options="ResonanceOptions" />
                                @if (current.Resonance is not null)
                                {
                                    <span class="ovr" title="@($"The weapon has {ModeLabel(weaponConditions.Resonance)}")">own</span>
                                }
                            </div>
                        }
                        <div class="cond-line">
                            <span class="muted small">Meal attack</span>
                            <NumberInput T="int" Value="effective.MealAttack" Min="0" Max="50" Width="90" ValueChanged="SetMealAttack" />
                            @if (current.MealAttack is not null)
                            {
                                <span class="ovr" title="@($"The weapon has {weaponConditions.MealAttack}")">own</span>
                            }
                        </div>
                        @{ var procs = shown.Where(x => x.Group == ConditionsPanel.ProcGroup).ToList(); }
                        @if (procs.Count > 0)
                        {
                            <div class="cond-grid compact">
                                @foreach (var x in procs)
                                {
                                    @BuildCondition(x, current, effective, weaponConditions)
                                }
                            </div>
                        }
                        <div class="cond-line">
                            <span class="muted small">Target</span>
                            <Segmented T="string" Small="true" Value="@TargetChoice(current)" ValueChanged="SetTargetChoice"
                                       Options="@TargetOptions(weaponTarget)" />
                            @if (current.Target is not null)
                            {
                                <span class="ovr" title="@($"The weapon's target is {weaponTarget.Name}")">own</span>
                            }
                        </div>
                        <p class="muted small">
                            Raw hitzone @Fmt.N(effective.Target.RawHitzone, 0), @(s.Element == Element.None ? "element" : Fmt.Slug(s.Element)) hitzone @Fmt.N(effective.Target.ElementHitzoneFor(s.Element), 0);
                            attack and skill limits are the weapon's. Hits of the scored attack without and with a crit: open the damage breakdown on the build card below.
                        </p>
                    </div>
                    <div class="status-screen">
                        <h4>As the status screen shows it</h4>
                        <dl>
                            <dt>Attack</dt>
                            <dd><b>@Fmt.N(st.TrueRaw, 1)</b> <span class="muted small">weapon @s.BaseAttack</span></dd>
                            <dt>Affinity</dt>
                            <dd><b>@st.Affinity%</b> <span class="muted small">weapon @s.BaseAffinity%</span></dd>
                            @if (s.Element != Element.None)
                            {
                                <dt>@Fmt.TitleCase(s.Element)</dt>
                                <dd><b>@st.ElementDisplay</b> <span class="muted small">weapon @b.Weapon.ElementDisplay, cap @Fmt.N(st.ElementCap * 10, 0)</span></dd>
                            }
                            <dt>Crit</dt>
                            <dd>x@(Fmt.N(st.CritMultiplier, 2))@(s.Element != Element.None && st.CritElement > 1 ? $", element x{Fmt.N(st.CritElement, 2)}" : "") <span class="muted small">@(st.Sharpness is { } sh ? $"{Fmt.TitleCase(sh)} sharpness" : "")</span></dd>
                        </dl>
                        @if (st.Modifiers.Count > 0)
                        {
                            <ul class="mods">
                                @foreach (var m in st.Modifiers)
                                {
                                    <li>@m</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="muted small">No conditional bonus is active.</p>
                        }
                    </div>
                </div>
            </ChildContent>
        </Section>
    }

    @if (ev is { Targets.Count: > 0 })
    {
        <Section Title="Targets" Hint="The requirements of this configuration, checked against this build (the optimizer only returns builds that meet all of them).">
            <div class="chip-row">
                @foreach (var t in ev.Targets)
                {
                    var bonus = t.Kind is SkillKind.Set or SkillKind.Group;
                    <SkillHover Name="@t.Skill" Class="@("chip tcheck " + (t.Met ? "met" : "miss"))">
                        <SkillIcon Name="@t.Skill" Size="18" />
                        <span>@(t.Met ? "✓" : "✗") @t.Label</span>
                        @if (!t.Met)
                        {
                            <span class="muted small">has @t.Actual@(bonus ? $" piece{(t.Actual == 1 ? "" : "s")}" : "")</span>
                        }
                        @if (t.FromCore)
                        {
                            <span class="muted small">core skill</span>
                        }
                    </SkillHover>
                }
            </div>
        </Section>
    }

    @{
        var breakdown = Breakdown(current);
        var refInput = reference is null ? null : reference.Input ?? (reference.Key.StartsWith("mine:") && int.TryParse(reference.Key[5..], out var ri) && ri < App.Builds.Count ? App.Builds[ri] : null);
        var refBreakdown = refInput is not null ? Breakdown(refInput) : null;
    }
    @if (breakdown is { Count: > 0 })
    {
        var maxPerMinute = breakdown.Max(x => x.DamagePerMinute);
        var refById = refBreakdown?.ToDictionary(x => x.Id) ?? [];
        <Section Title="Damage per attack"
                 Hint="This build on every move, combo and example sequence, under the current conditions and target. The build is scored on the highlighted one (Conditions tab); per minute uses each attack's own pace, so it compares attacks with each other. Click a row for its hits.">
            <Actions>
                @if (_expanded.Count > 0)
                {
                    <span class="mode-pick" title="The damage the hits of opened rows show">
                        <span class="muted small">Hits</span>
                        <Segmented T="DamageMode" Small="true" Value="_mode" ValueChanged="m => _mode = m" Options="ModeOptions" />
                    </span>
                }
            </Actions>
            <ChildContent>
            <table class="table attack-damage">
                <thead>
                    <tr>
                        <th>Attack</th>
                        <th class="num narrow-hide">Hits</th>
                        <th class="num narrow-hide">MV</th>
                        <th class="num">Damage</th>
                        <th class="num">Per minute</th>
                        @if (refBreakdown is not null)
                        {
                            <th class="num" title="@($"This build minus {reference!.Label}, per execution")">vs @reference!.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in breakdown.GroupBy(x => x.Group))
                    {
                        <tr class="attack-group"><td colspan="@(refBreakdown is not null ? 6 : 5)">@group.Key</td></tr>
                        @foreach (var x in group)
                        {
                            var open = _expanded.Contains(x.Id);
                            <tr @key="x.Id" class="attack-row @(x.Current ? "current" : "") @(open ? "open" : "")" @onclick="() => ToggleAttack(x.Id)"
                                title="@(open ? "Hide the hits" : "Show every hit without and with a crit, step conditions and modifiers")">
                                <td>
                                    <span class="row-toggle" aria-expanded="@open">@(open ? "▾" : "▸")</span>
                                    @x.Name @if (x.Current) {<span class="scored-badge" title="The build's score uses this attack">scored on</span>}
                                </td>
                                <td class="num narrow-hide">@Fmt.N(x.Hits, 0)</td>
                                <td class="num muted narrow-hide">@Fmt.N(x.Mv, 0)</td>
                                <td class="num"><b>@Fmt.N(x.DamagePerExecution, 0)</b></td>
                                <td class="num">
                                    <span class="permin-cell">
                                        <span class="permin-track"><span class="permin-bar" style="width: @((100 * x.DamagePerMinute / Math.Max(1, maxPerMinute)).ToString("0.#", CultureInfo.InvariantCulture))%"></span></span>
                                        <span class="permin-value">@Fmt.N(x.DamagePerMinute, 0)</span>
                                    </span>
                                </td>
                                @if (refBreakdown is not null)
                                {
                                    <td class="num">
                                        @if (refById.GetValueOrDefault(x.Id) is { } other)
                                        {
                                            var pct = other.DamagePerExecution != 0 ? (x.DamagePerExecution - other.DamagePerExecution) / other.DamagePerExecution * 100 : 0;
                                            <Delta Value="@(x.DamagePerExecution - other.DamagePerExecution)" Digits="0" /> <span class="muted small">(@(pct >= 0 ? "+" : "−")@Fmt.N(Math.Abs(pct), 1)%)</span>
                                        }
                                        else
                                        {
                                            <span class="muted">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                            @if (open && Detail(current, x.Id) is { } detail)
                            {
                                <tr @key="@(x.Id + ":detail")" class="attack-detail-row">
                                    <td colspan="@(refBreakdown is not null ? 6 : 5)"><AttackDetailView Detail="detail" Element="@(b?.Summary.Element ?? Element.None)" Mode="_mode" /></td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
            <p class="muted small">Damage against the target before the monster's defense rate and per-hit rounding, like the score.</p>
            </ChildContent>
        </Section>
    }

    <Section Title="Compare"
             Hint="@(reference?.Input is not null ? "The optimizer build is scored again under this build's conditions, so both sides use the same assumptions." : "Differences are this build minus the other one, each under its own conditions; green means this build is ahead.")">
        <Actions>
            @if (references.Count > 0)
            {
                <SelectBox Value="@reference?.Key" ValueChanged="key => App.SetCompareKey(key)" Style="min-width: 280px"
                           Options="@references.Select(r => new SelectOption(r.Key, r.Label + (r.RunScore is { } rs ? $" ({Fmt.N(rs)} in the run)" : r.Build is { } rb ? $" ({Fmt.N(rb.Score)})" : ""), r.Group)).ToList()" />
            }
        </Actions>
        <ChildContent>
            @if (reference is null)
            {
                <p class="muted">Run the optimizer or add a second build to have something to compare with.</p>
            }
            else
            {
                @foreach (var e in scoredRef?.Errors ?? [])
                {
                    <Alert Kind="error">@reference.Label: @e</Alert>
                }
                @if (reference.RunScore is { } runScore && refBuild is not null && Math.Abs(refBuild.Score - runScore) > 0.05)
                {
                    <Alert Kind="info">The run scored @reference.Label at @Fmt.N(runScore); under the current conditions it scores @Fmt.N(refBuild.Score). Run the optimizer again after changing conditions.</Alert>
                }
                @if (b is not null && refBuild is not null)
                {
                    <BuildCompare A="b" ALabel="@(current.Name.Length > 0 ? current.Name : "This build")" B="refBuild" BLabel="@reference.Label" />
                }
                else if (scoredRef is not { Errors.Count: > 0 })
                {
                    <p class="muted">Scoring…</p>
                }
            }
        </ChildContent>
    </Section>

    @if (b is not null)
    {
        <BuildCard Build="b" Title="@(current.Name.Length > 0 ? current.Name : "This build")" Compact="true" />
    }
</div>

@code {
    /// <summary>Something to compare the selected build with: an optimizer build (scored again under the current request) or another of your builds.</summary>
    private sealed record Reference(string Key, string Label, string Group, BuildInput? Input, BuildDto? Build, double? RunScore = null);

    private List<Reference> References(int index)
    {
        var refs = new List<Reference>();
        var pairs = App.Run.Result?.Pairs ?? [];
        foreach (var p in pairs)
            foreach (var build in p.Builds)
            {
                var label = pairs.Count > 1 ? $"Pair #{p.Rank} build {build.Rank}" : $"Optimizer build {build.Rank}";
                refs.Add(new Reference($"opt:{p.Rank}:{build.Rank}", label, "Optimizer results", BuildHelpers.FromBuild(build, label), null, build.Score));
            }
        for (var i = 0; i < App.Builds.Count; i++)
            if (i != index)
                refs.Add(new Reference($"mine:{i}", App.Builds[i].Name, "My builds", null, App.Evaluated is { } e && i < e.Count ? e[i].Build : null));
        return refs;
    }

    // the optimizer build being compared, scored under the current request (cached until the request, talismans or build change)
    private (OptimizationRequest? Request, IReadOnlyList<TalismanInput>? Talismans, string Key, EvaluatedBuildDto? Result) _scored;

    private EvaluatedBuildDto? Score(BuildInput input)
    {
        var key = System.Text.Json.JsonSerializer.Serialize(input, BrowserProfileStore.Json);
        if (ReferenceEquals(_scored.Request, App.Request) && ReferenceEquals(_scored.Talismans, App.Talismans) && _scored.Key == key) return _scored.Result;
        EvaluatedBuildDto? result;
        try
        {
            var payload = new ConfigPayload(App.Request!, App.Talismans.ToList(), [input]);
            result = BuildEvaluation.Evaluate(payload, Resolving.Resolve(payload, App.Data, App.Store.Directory), App.Data).FirstOrDefault();
        }
        catch (Exception e)
        {
            result = new EvaluatedBuildDto(input.Name, [$"Scoring failed: {e.Message}"], [], null, []);
        }
        _scored = (App.Request, App.Talismans, key, result);
        return result;
    }

    // per-attack damage of a build, cached until the request, talismans or build change
    private readonly Dictionary<string, IReadOnlyList<AttackRowDto>> _breakdowns = new();
    private (OptimizationRequest? Request, IReadOnlyList<TalismanInput>? Talismans) _breakdownBasis;

    // rows of the damage-per-attack table that are open, and their details (cached like the rows)
    private readonly HashSet<string> _expanded = [];
    private DamageMode _mode = DamageMode.Average;

    private static readonly IReadOnlyList<SegmentOption<DamageMode>> ModeOptions =
        [new(DamageMode.NonCrit, "Non-crit"), new(DamageMode.Crit, "Crit"), new(DamageMode.Average, "Average", Hint: "Averaged over the affinity: what the score counts")];
    private readonly Dictionary<string, AttackDetailDto?> _details = new();

    private void ToggleAttack(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private AttackDetailDto? Detail(BuildInput input, string id)
    {
        Breakdown(input); // drops stale details with the rows
        var key = id + "|" + System.Text.Json.JsonSerializer.Serialize(input, BrowserProfileStore.Json);
        if (_details.TryGetValue(key, out var cached)) return cached;
        AttackDetailDto? detail;
        try
        {
            var payload = new ConfigPayload(App.Request!, App.Talismans.ToList(), [input]);
            detail = BuildEvaluation.AttackDetail(Resolving.Resolve(payload, App.Data, App.Store.Directory), input, App.Data, id);
        }
        catch (Exception)
        {
            detail = null;
        }
        _details[key] = detail;
        return detail;
    }

    private IReadOnlyList<AttackRowDto>? Breakdown(BuildInput input)
    {
        if (!ReferenceEquals(_breakdownBasis.Request, App.Request) || !ReferenceEquals(_breakdownBasis.Talismans, App.Talismans))
        {
            _breakdowns.Clear();
            _details.Clear();
            _breakdownBasis = (App.Request, App.Talismans);
        }
        var key = System.Text.Json.JsonSerializer.Serialize(input, BrowserProfileStore.Json);
        if (_breakdowns.TryGetValue(key, out var cached)) return cached;
        IReadOnlyList<AttackRowDto> rows;
        try
        {
            var payload = new ConfigPayload(App.Request!, App.Talismans.ToList(), [input]);
            rows = BuildEvaluation.AttackBreakdown(Resolving.Resolve(payload, App.Data, App.Store.Directory), input, App.Data);
        }
        catch (Exception)
        {
            rows = []; // the weapon or the build has errors; the cards above say which
        }
        _breakdowns[key] = rows;
        return rows;
    }

    // ---------------- the build's own conditions ----------------
    private bool _allConditions;

    private static readonly IReadOnlyList<SegmentOption<ResonanceMode>> ResonanceOptions =
        [new(ResonanceMode.None, "Off"), new(ResonanceMode.Local, "Local (affinity)"), new(ResonanceMode.Remote, "Remote (attack)")];

    private static string ModeLabel(ResonanceMode m) => m switch { ResonanceMode.None => "it off", ResonanceMode.Local => "Local", _ => "Remote" };

    private const string TargetWeapon = "weapon";

    private static IReadOnlyList<SegmentOption<string>> TargetOptions(Target weaponTarget) =>
    [
        new(TargetWeapon, $"Weapon's: {weaponTarget.Name}"),
        .. Target.DummyParts.Select(d => new SegmentOption<string>(d.Part!, $"Dummy {d.Part!.ToLowerInvariant()}", Hint: $"Training dummy, raw {Fmt.N(d.RawHitzone, 0)} / element {Fmt.N(d.ElementHitzone, 0)}")),
    ];

    private static string TargetChoice(BuildInput b) => b.Target is { Kind: TargetKind.Dummy, Part: { } part } ? part : b.Target is null ? TargetWeapon : "custom";

    private void SetTargetChoice(string choice) => Update(b => b with { Target = choice == TargetWeapon ? null : Target.Dummy(choice) });

    private void SetResonance(ResonanceMode mode) => Update(b => b with { Resonance = mode == App.Request!.Conditions.Resonance ? null : mode });

    private void SetMealAttack(int meal) => Update(b => b with { MealAttack = meal == App.Request!.Conditions.MealAttack ? null : meal });

    /// <summary>A toggle that equals the weapon's value follows the weapon again instead of overriding it.</summary>
    private void SetCondition(string key, bool value) => Update(b =>
    {
        var overrides = new Dictionary<string, bool>(b.Conditions);
        if (ConditionToggles.Get(App.Request!.Conditions, key) == value) overrides.Remove(key);
        else overrides[key] = value;
        return b with { Conditions = overrides };
    });

    private static bool HasSkill(BuildDto b, string name) =>
        b.Skills.Any(x => x.Skill == name && x.Level > 0) || b.SetBonuses.Any(x => x.Name == name && x.Active) || b.GroupSkills.Any(x => x.Name == name && x.Active);

    private RenderFragment BuildCondition(ConditionDto x, BuildInput build, Conditions effective, Conditions weapon) => __builder =>
    {
        var on = ConditionAccess.Get(effective, x.Property);
        var own = build.Conditions.ContainsKey(x.Key);
        <label @key="x.Key" class="cond @(on ? "on" : "") @(own ? "overridden" : "")" title="@x.Description">
            <input type="checkbox" checked="@on" @onchange="e => SetCondition(x.Key, e.Value is true)" />
            <span class="cond-text">
                <b>
                    @x.Label
                    @if (own)
                    {
                        <span class="ovr" title="@($"The weapon has this {(ConditionAccess.Get(weapon, x.Property) ? "on" : "off")}; this build overrides it.")">own</span>
                    }
                </b>
                <span class="cond-skills">
                    @foreach (var sk in x.Skills)
                    {
                        var bare = SkillSuffix.Replace(sk, "");
                        var skill = Cat.SkillsByName.GetValueOrDefault(bare);
                        <SkillHover @key="sk" Name="@bare" Class="@($"chip skill {(skill?.Kind ?? SkillKind.Armor).ToString().ToLowerInvariant()} tiny")">
                            <SkillIcon Name="@bare" Kind="skill?.Kind" Size="14" />@sk
                        </SkillHover>
                    }
                </span>
            </span>
        </label>
    };

    /// <summary>"Lord's Soul (Guts)" -> "Lord's Soul".</summary>
    private static readonly System.Text.RegularExpressions.Regex SkillSuffix = new(@"\s*\(.*\)$");

    private void Update(Func<BuildInput, BuildInput> fn)
    {
        var index = Math.Max(0, Math.Min(App.BuildIndex, App.Builds.Count - 1));
        App.SetBuilds(list => list.Select((b, i) => i == index ? fn(b) : b).ToList());
    }

    private List<string> Names => App.Builds.Select(b => b.Name).ToList();

    private void NewBuild() => AddNew(BuildHelpers.Empty(BuildHelpers.UniqueName("My build", Names)));

    private void StartFrom(BuildDto optimizerBuild)
    {
        AddNew(BuildHelpers.FromBuild(optimizerBuild, "Optimizer build 1 (copy)"));
        App.SetCompareKey(null);
    }

    private void Duplicate(BuildInput current) => AddNew(AppState.Clone(current) with { Name = BuildHelpers.UniqueName(current.Name + " copy", Names), Picked = false });

    private void Rename(string? name) => Update(b => b with { Name = name ?? "" });

    private void AddNew(BuildInput build)
    {
        var count = App.Builds.Count;
        App.SetBuilds(list => [.. list, build]);
        App.SetBuildIndex(count);
    }

    private async Task Remove(BuildInput current, int index)
    {
        if (!await App.ConfirmAsync("Delete build", $"Delete the build \"{current.Name}\"?", "Delete")) return;
        App.SetBuilds(list => list.Where((_, i) => i != index).ToList());
        App.SetBuildIndex(Math.Max(0, index - 1));
        if (App.CompareKey?.StartsWith("mine:") == true) App.SetCompareKey(null);
    }
}
