@inject AppState App
@* An item's wiki page: the game's text, what it does in numbers, what it stacks with, where to get it and what it makes. *@
@{
    var i = Item;
    var src = i.Sources;
    var hasEffect = i.Boost is not null || i.Duration is not null || i.Effects.Count > 0 || i.Stacking is not null || i.Notes is { Count: > 0 };
}
<div class="panel wiki-page">
    <section class="card wiki-head item">
        <div class="wiki-title">
            <img class="icon" width="36" height="36" src="@GameIcons.Item(i.Icon, i.IconColor)" alt="" />
            <div>
                <h1>@i.Name</h1>
                <div class="chip-row">
                    <span class="muted small">@CategoryTitle</span>
                    <RarityBadge Rarity="i.Rarity" />
                    <span class="muted small">carry @i.CarryLimit</span>
                </div>
            </div>
        </div>
        @if (i.Description is { } d)
        {
            <p class="wiki-desc">@d</p>
        }
    </section>

    @if (hasEffect)
    {
        <Section Title="What it does" Key="wiki-item-effect" Collapsible="false">
            @if (i.Boost is not null || i.Duration is not null)
            {
                <div class="wiki-item-stats">
                    @if (i.Boost is { } boost)
                    {
                        <div><span class="muted tiny">Effect</span><b>@boost</b></div>
                    }
                    @if (i.Duration is { } duration)
                    {
                        <div><span class="muted tiny">Lasts</span><b>@duration</b></div>
                    }
                </div>
            }
            <ul class="wiki-item-effects">
                @foreach (var line in i.Effects)
                {
                    <li>@line</li>
                }
            </ul>
            @if (i.Stacking is { } stacking)
            {
                <p class="wiki-stacking"><span class="muted tiny">Stacking</span> @stacking</p>
            }
            @if (i.Notes is { Count: > 0 } notes)
            {
                <ul class="wiki-notes">
                    @foreach (var n in notes)
                    {
                        <li>@n</li>
                    }
                </ul>
            }
            @if (i.Source is { } source)
            {
                <p class="wiki-source tiny muted">Source: @source</p>
            }
        </Section>
    }

    @if (i.Recipes is { Count: > 0 } || src is not null)
    {
        <Section Title="Where to get it" Key="wiki-item-get" Collapsible="false">
            <dl class="wiki-get">
                @foreach (var line in src?.Other ?? [])
                {
                    <dt>How</dt>
                    <dd>@line</dd>
                }
                @if (i.Recipes is { Count: > 0 } recipes)
                {
                    <dt>Combine</dt>
                    <dd>
                        @foreach (var recipe in recipes)
                        {
                            <div class="chip-row">
                                @for (var k = 0; k < recipe.Count; k++)
                                {
                                    var part = recipe[k];
                                    @if (k > 0)
                                    {
                                        <span class="muted">+</span>
                                    }
                                    <ItemChip Name="@part" Wiki="Wiki" />
                                }
                            </div>
                        }
                    </dd>
                }
                @if (src?.Gather is { Count: > 0 } gather)
                {
                    <dt>Gather</dt>
                    <dd class="wiki-gather">
                        @foreach (var spot in gather)
                        {
                            <div><b>@spot.Region</b> <span class="muted">@(spot.Areas.Count == 1 ? "area" : "areas") @string.Join(", ", spot.Areas)</span></div>
                        }
                    </dd>
                }
                @if (src?.Retrieval is { Count: > 0 } retrieval)
                {
                    <dt>Retrieval</dt>
                    <dd>Material retrieval in @Fmt.JoinAnd(retrieval)</dd>
                }
                @if (src?.Shop == true)
                {
                    <dt>Shop</dt>
                    <dd>Sold at the item shop</dd>
                }
                @if (src?.SupportShip == true)
                {
                    <dt>Support ship</dt>
                    <dd>In the support ship's stock now and then</dd>
                }
                @if (src?.Monsters is { Count: > 0 } monsters)
                {
                    <dt>Monsters</dt>
                    <dd>
                        <div class="dmg-scroll">
                            <table class="table wiki-drops">
                                <thead><tr><th>Monster</th><th>Rank</th><th>How</th><th class="num">Chance</th></tr></thead>
                                <tbody>
                                    @foreach (var group in monsters.GroupBy(m => m.Monster))
                                    {
                                        var first = true;
                                        @foreach (var drop in group)
                                        {
                                            <tr class="@(first ? "first" : "")">
                                                <td>@(first ? drop.Monster : "")</td>
                                                <td>@drop.Rank</td>
                                                <td>@drop.How</td>
                                                <td class="num">@drop.Chance%</td>
                                            </tr>
                                            first = false;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </dd>
                }
            </dl>
            @if (SourceNote(src) is { } note)
            {
                <p class="wiki-source tiny muted">@note</p>
            }
        </Section>
    }

    @if (i.UsedIn is { Count: > 0 } || i.Related is { Count: > 0 })
    {
        <Section Title="Related items" Key="wiki-item-craft" Collapsible="false">
            @if (i.UsedIn is { Count: > 0 } usedIn)
            {
                <div class="wiki-src">
                    <h3>Used to make</h3>
                    <div class="chip-row">
                        @foreach (var name in usedIn)
                        {
                            <ItemChip Name="@name" Wiki="Wiki" />
                        }
                    </div>
                </div>
            }
            @if (i.Related is { Count: > 0 } related)
            {
                <div class="wiki-src">
                    <h3>Compare with</h3>
                    <div class="chip-row">
                        @foreach (var name in related)
                        {
                            <ItemChip Name="@name" Wiki="Wiki" />
                        }
                    </div>
                </div>
            }
        </Section>
    }
</div>

@code {
    [Parameter, EditorRequired] public WikiItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public WikiIndex Wiki { get; set; } = default!;

    private string CategoryTitle => Wiki.Data.ItemCategories?.FirstOrDefault(c => c.Key == Item.Category)?.Title ?? Item.Category;

    /// <summary>Where the page's source lines come from, for the ones it shows.</summary>
    private static string? SourceNote(WikiItemSources? s)
    {
        if (s is null) return null;
        var game = new[] { s.Retrieval is not null ? "retrieval" : null, s.Shop == true ? "shop" : null, s.SupportShip == true ? "support ship" : null }
            .OfType<string>().ToList();
        string?[] parts =
        [
            s.Gather is not null ? "gathering spots from Cola's map of the game data (c-ola.github.io/wildsmap, via monsterhunterwiki.org)" : null,
            game.Count > 0 ? Fmt.JoinAnd(game) + " from the game data" : null,
            s.Monsters is not null ? "monster rewards from wilds.mhdb.io" : null,
        ];
        var text = string.Join("; ", parts.OfType<string>());
        return text.Length == 0 ? null : "Sources: " + text + ".";
    }
}
