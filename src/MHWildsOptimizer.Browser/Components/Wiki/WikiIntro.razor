@inject AppState App
@* What a wiki section holds, shown until an entry is picked from the list. *@
<div class="panel wiki-page">
    @if (Missing is not null)
    {
        <Alert Kind="warning">There is no “@Missing” in the @Name. Pick one from the list.</Alert>
    }
    <Section Title="@Title" Key="wiki-intro" Collapsible="false">
        @switch (Section)
        {
            case Tab.WikiItems:
                <p>
                    The consumables you carry on every hunt and what they do in numbers (the game's own texts only say "temporarily"):
                    how much attack or defense, for how long, and which of them add up. The materials they are made from are here too,
                    with where to gather, retrieve, buy or carve each one.
                </p>
                @foreach (var category in Wiki.Data.ItemCategories ?? [])
                {
                    var items = (Wiki.Data.Items ?? []).Where(i => i.Category == category.Key).ToList();
                    if (items.Count == 0) continue;
                    var materials = category.Key == "materials";
                    <h3 class="wiki-subhead">@category.Title</h3>
                    @if (category.About is { } about)
                    {
                        <p class="muted small">@about</p>
                    }
                    <div class="dmg-scroll">
                        <table class="table wiki-item-table">
                            <thead>
                                <tr>
                                    <th></th><th>Item</th>
                                    @if (materials)
                                    {
                                        <th>Where to get it</th>
                                    }
                                    else
                                    {
                                        <th>Effect</th><th>Lasts</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in items)
                                {
                                    <tr>
                                        <td class="icon-cell"><img class="icon" width="22" height="22" src="@GameIcons.Item(i.Icon, i.IconColor)" alt="" /></td>
                                        <td><button class="linklike" @onclick="() => App.OpenWiki(Section, i.Name)">@i.Name</button></td>
                                        @if (materials)
                                        {
                                            <td class="wiki-get-summary">@WikiIndex.SourceSummary(i)</td>
                                        }
                                        else
                                        {
                                            <td>@(i.Boost ?? "—")</td>
                                            <td class="num">@(i.Duration ?? "—")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                break;
            case Tab.WikiMeals:
                var meals = Wiki.Data.Meals;
                @foreach (var line in meals?.About ?? [])
                {
                    <p>@line</p>
                }
                @foreach (var table in meals?.Tables ?? [])
                {
                    <div class="wiki-subtable wiki-meal-table">
                        <h3>@table.Title</h3>
                        <div class="dmg-scroll">
                            <table class="table">
                                <thead><tr>@foreach (var c in table.Columns) { <th>@c</th> }</tr></thead>
                                <tbody>
                                    @foreach (var row in table.Rows)
                                    {
                                        <tr>@foreach (var c in row) { <td>@c</td> }</tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                @if (meals?.Notes is { Count: > 0 } notes)
                {
                    <ul class="wiki-notes">
                        @foreach (var n in notes)
                        {
                            <li>@n</li>
                        }
                    </ul>
                }
                @if (meals?.Source is { } source)
                {
                    <p class="wiki-source tiny muted">@source</p>
                }
                <h3 class="wiki-subhead">Meal skills</h3>
                <div class="chip-row">
                    @foreach (var m in (meals?.Skills ?? []).OrderBy(m => m.Name))
                    {
                        <button class="chip" @onclick="() => App.OpenWiki(Section, m.Name)">
                            <img class="icon" width="18" height="18" src="@GameIcons.SkillGeneric(m.Icon)" alt="" />@m.Name
                        </button>
                    }
                </div>
                break;
            case Tab.WikiArmor:
                <p>
                    Every armor set, high and low rank: each piece's skills, decoration slots (and what Armor Transcendence makes of them),
                    defense and resistances, the totals for the full set, and what its set bonus and group skill do.
                </p>
                <p class="muted small">
                    @Fmt.Plural(Wiki.Data.ArmorSets.Count(s => s.Rank == "high"), "high rank set") ·
                    @Fmt.Plural(Wiki.Data.ArmorSets.Count(s => s.Rank == "low"), "low rank set")
                </p>
                break;
            default:
                var weaponOnly = Wiki.Data.Skills.Where(s => s.WeaponOnly).ToList();
                <p>
                    Every skill in the game, with what each level actually does in numbers (the game's own texts are often vague), and
                    where to get it: decorations, charms, armor pieces and weapons with it built in. Set skills are in the same list:
                    set bonuses (two tiers, at 2 and 4 pieces of the same set bonus) and group skills (3 pieces with the same group skill,
                    from any sets), with the sets that carry them. A Gogma Artian weapon that rolled one counts as a piece.
                </p>
                <p class="muted small">
                    @Fmt.Plural(Wiki.Data.Skills.Count(s => s.Kind == SkillKind.Armor), "armor skill") ·
                    @Fmt.Plural(Wiki.Data.Skills.Count(s => s.Kind == SkillKind.Weapon), "weapon skill") ·
                    @Fmt.Plural(Wiki.Data.Skills.Count(s => s.Kind is SkillKind.Set or SkillKind.Group), "set skill") ·
                    numbers from the game data (dtlnor/MHWs-in-json), kiranico and community tests.
                </p>
                <h3 class="wiki-subhead">Only on weapons</h3>
                <p class="muted small">No decoration, armor piece or charm carries these: only certain weapons have them built in.</p>
                <div class="chip-row">
                    @foreach (var s in weaponOnly)
                    {
                        <button class="chip skill weapon" @onclick="() => App.OpenWiki(Section, s.Name)">
                            <SkillIcon Name="@s.Name" Kind="s.Kind" Size="18" />@s.Name
                        </button>
                    }
                </div>
                <h3 class="wiki-subhead">Set skills</h3>
                <div class="chip-row">
                    @foreach (var s in Wiki.Data.Skills.Where(s => s.Kind is SkillKind.Set or SkillKind.Group).OrderBy(s => s.Kind).ThenBy(s => s.Name))
                    {
                        <button class="chip skill @s.Kind.ToString().ToLowerInvariant()" @onclick="() => App.OpenWiki(Section, s.Name)">
                            <SkillIcon Name="@s.Name" Kind="s.Kind" Size="18" />@s.Name
                        </button>
                    }
                </div>
                break;
        }
    </Section>
</div>

@code {
    [Parameter, EditorRequired] public Tab Section { get; set; }
    [Parameter, EditorRequired] public WikiIndex Wiki { get; set; } = default!;
    /// <summary>The entry the URL named that does not exist.</summary>
    [Parameter] public string? Missing { get; set; }

    private string Title => Section switch
    {
        Tab.WikiArmor => "Armor sets",
        Tab.WikiItems => "Items",
        Tab.WikiMeals => "Meals",
        _ => "Skills",
    };

    private string Name => Title.ToLowerInvariant();
}
