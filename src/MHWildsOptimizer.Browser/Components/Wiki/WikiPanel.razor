@inherits AppComponent
@inject WikiService Wiki
@* The game reference: a searchable list of the section's entries next to the open entry (on phones one or the other).
   Sections: skills (set and group bonuses among them), armor sets, weapons (by type, the entry a weapon or a type), items, meal skills; the URL names the open entry, so pages can be linked. *@

@if (_error is not null)
{
    <div class="panel">
        <Alert Kind="error">The wiki data could not be loaded: @_error</Alert>
        <div><button class="btn" @onclick="LoadAsync">Try again</button></div>
    </div>
}
else if (_wiki is not { } wiki)
{
    <div class="progress"><span class="spinner"></span>Loading the wiki…</div>
}
else
{
    var section = App.Tab;
    var entry = App.WikiEntry;
    <div class="wiki @(entry is null ? "" : "has-entry")">
        <aside class="wiki-side card">
            <div class="wiki-tools">
                <SearchBox Value="@Query(section)" ValueChanged="@(q => _queries[section] = q ?? string.Empty)" Placeholder="@SearchHint(section)" />
                @if (section == Tab.WikiArmor)
                {
                    <Segmented T="string" Small="true" Value="_rank" ValueChanged="v => _rank = v" Options="RankOptions" />
                }
                else if (section == Tab.WikiSkills)
                {
                    <Segmented T="string" Small="true" Value="_filter" ValueChanged="v => _filter = v" Options="SkillFilters" />
                }
                else if (section == Tab.WikiWeapons)
                {
                    var kind = WeaponKind(wiki, entry);
                    <div class="type-row">
                        @foreach (var t in Catalog.WeaponTypes)
                        {
                            <button type="button" class="@(t.Kind == kind ? "active" : "")" title="@($"{t.Label} · {Fmt.Plural(wiki.WeaponsByKind.GetValueOrDefault(t.Kind)?.Count ?? 0, "weapon")}")"
                                    @onclick="() => PickKind(t.Kind)"><img src="@GameIcons.Weapon(t.Kind)" alt="@t.Label" /></button>
                        }
                    </div>
                }
            </div>
            <div class="wiki-list" role="list">
                @if (section == Tab.WikiItems)
                {
                    var items = Items(wiki).ToList();
                    <div class="wiki-count muted tiny">@Fmt.Plural(items.Count, "item")</div>
                    @foreach (var group in items.GroupBy(i => i.Category))
                    {
                        <div class="wiki-list-head muted tiny">@CategoryTitle(wiki, group.Key)</div>
                        @foreach (var i in group)
                        {
                            <button @key="i.Name" role="listitem" class="wiki-row @(i.Name == entry ? "active" : "")" @onclick="() => App.OpenWiki(section, i.Name)">
                                <img class="icon" width="22" height="22" src="@GameIcons.Item(i.Icon, i.IconColor)" alt="" />
                                <span class="wiki-row-name">@i.Name</span>
                                @if (i.Boost is { } boost)
                                {
                                    <span class="muted tiny wiki-row-note">@boost</span>
                                }
                            </button>
                        }
                    }
                }
                else if (section == Tab.WikiMeals)
                {
                    var meals = MealSkills(wiki).ToList();
                    <div class="wiki-count muted tiny">@Fmt.Plural(meals.Count, "meal skill")</div>
                    @foreach (var m in meals)
                    {
                        <button @key="m.Name" role="listitem" class="wiki-row @(m.Name == entry ? "active" : "")" @onclick="() => App.OpenWiki(section, m.Name)">
                            <img class="icon" width="22" height="22" src="@GameIcons.SkillGeneric(m.Icon)" alt="" />
                            <span class="wiki-row-name">@m.Name</span>
                        </button>
                    }
                }
                else if (section == Tab.WikiWeapons)
                {
                    var kind = WeaponKind(wiki, entry);
                    var weapons = Weapons(wiki, kind).ToList();
                    <div class="wiki-count muted tiny">@Fmt.Plural(weapons.Count, "weapon") · @Fmt.Plural(weapons.Select(w => w.Tree).Distinct().Count(), "tree")</div>
                    @foreach (var group in weapons.GroupBy(w => w.Tree))
                    {
                        <div class="wiki-list-head muted tiny">@WikiIndex.TreeLabel(group.Key)</div>
                        @foreach (var w in group.OrderByDescending(w => w.Rarity).ThenByDescending(w => w.Col))
                        {
                            <button @key="w.Name" role="listitem" class="wiki-row @(w.Name == entry ? "active" : "")" @onclick="() => App.OpenWiki(section, w.Name)">
                                <img class="icon" width="22" height="22" src="@GameIcons.Weapon(w.Kind)" alt="" />
                                <span class="wiki-row-name @(w.IsFinal ? "final" : "")">@w.Name</span>
                                <RarityBadge Rarity="w.Rarity" />
                            </button>
                        }
                    }
                }
                else if (section == Tab.WikiArmor)
                {
                    var sets = Sets(wiki).ToList();
                    <div class="wiki-count muted tiny">@Fmt.Plural(sets.Count, "set")</div>
                    @foreach (var s in sets)
                    {
                        <button @key="s.Name" role="listitem" class="wiki-row @(s.Name == entry ? "active" : "")" @onclick="() => App.OpenWiki(section, s.Name)">
                            <img class="icon" width="22" height="22" src="@GameIcons.Armor(s.Pieces[0].Piece, s.Rarity)" alt="" />
                            <span class="wiki-row-name">@s.Name</span>
                            <RarityBadge Rarity="s.Rarity" />
                        </button>
                    }
                }
                else
                {
                    var skills = Skills(wiki).ToList();
                    <div class="wiki-count muted tiny">@Fmt.Plural(skills.Count, "skill")</div>
                    @foreach (var s in skills)
                    {
                        <button @key="s.Name" role="listitem" class="wiki-row @(s.Name == entry ? "active" : "")" @onclick="() => App.OpenWiki(section, s.Name)">
                            <SkillIcon Name="@s.Name" Kind="s.Kind" Size="22" />
                            <span class="wiki-row-name">@s.Name</span>
                            @if (s.WeaponOnly)
                            {
                                <span class="wiki-flag" title="Only on weapons: no decoration, armor piece or charm has it">weapon only</span>
                            }
                            @if (s.Kind is SkillKind.Set or SkillKind.Group)
                            {
                                <KindTag Kind="s.Kind" />
                            }
                            else
                            {
                                <span class="muted tiny">Lv @s.MaxLevel</span>
                            }
                        </button>
                    }
                }
            </div>
        </aside>
        <div class="wiki-main">
            @if (entry is not null)
            {
                <button class="linklike wiki-back" @onclick="() => App.OpenWiki(section)">← all @ListName(section)</button>
            }
            @if (section == Tab.WikiItems)
            {
                if (entry is not null && wiki.Items.TryGetValue(entry, out var item))
                {
                    <WikiItemPage Item="item" Wiki="wiki" />
                }
                else
                {
                    <WikiIntro Section="section" Wiki="wiki" Missing="@entry" />
                }
            }
            else if (section == Tab.WikiMeals)
            {
                if (entry is not null && wiki.MealSkills.TryGetValue(entry, out var meal))
                {
                    <WikiMealSkillPage Skill="meal" Wiki="wiki" />
                }
                else
                {
                    <WikiIntro Section="section" Wiki="wiki" Missing="@entry" />
                }
            }
            else if (section == Tab.WikiWeapons)
            {
                if (entry is not null && wiki.Weapons.TryGetValue(entry, out var weapon))
                {
                    <WikiWeaponPage Weapon="weapon" Wiki="wiki" />
                }
                else
                {
                    <WikiWeaponTypePage Kind="@WeaponKind(wiki, entry)" Wiki="wiki" />
                }
            }
            else if (section == Tab.WikiArmor)
            {
                if (entry is not null && wiki.Sets.TryGetValue(entry, out var set))
                {
                    <WikiArmorPage Set="set" Wiki="wiki" />
                }
                else
                {
                    <WikiIntro Section="section" Wiki="wiki" Missing="@entry" />
                }
            }
            else if (entry is not null && wiki.Skills.TryGetValue(entry, out var skill))
            {
                <WikiSkillPage Skill="skill" Wiki="wiki" />
            }
            else
            {
                <WikiIntro Section="section" Wiki="wiki" Missing="@entry" />
            }
        </div>
    </div>
}

@code {
    private WikiIndex? _wiki;
    private string? _error;
    private readonly Dictionary<Tab, string> _queries = [];
    private string _filter = "all";
    private string _rank = "high";
    /// <summary>The weapon type the Weapons section shows; null = the open weapon's type.</summary>
    private string? _weaponKind;

    private static readonly IReadOnlyList<SegmentOption<string>> SkillFilters =
    [
        new("all", "All"),
        new("skills", "Skills", Hint: "Armor and weapon skills, with levels"),
        new("set", "Set skills", Hint: "Set bonuses (2 and 4 pieces) and group skills (3 pieces)"),
    ];

    private static readonly IReadOnlyList<SegmentOption<string>> RankOptions = [new("high", "High rank"), new("low", "Low rank")];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _wiki = await Wiki.LoadAsync();
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private string Query(Tab section) => _queries.GetValueOrDefault(section, "");

    private static string SearchHint(Tab section) => section switch
    {
        Tab.WikiArmor => "Set, piece or skill…",
        Tab.WikiItems => "Item, effect or ingredient…",
        Tab.WikiMeals => "Meal skill or effect…",
        Tab.WikiWeapons => "Weapon, tree, element or skill…",
        _ => "Skill, set bonus or effect…",
    };

    private static string ListName(Tab section) => section switch
    {
        Tab.WikiArmor => "armor sets",
        Tab.WikiItems => "items",
        Tab.WikiMeals => "meal skills",
        Tab.WikiWeapons => "weapons",
        _ => "skills",
    };

    /// <summary>The type the Weapons section shows: the open entry's (a weapon, or a type picked by its kind), else the last pick, else the open weapon's.</summary>
    private string WeaponKind(WikiIndex wiki, string? entry)
    {
        if (entry is not null && wiki.Weapons.TryGetValue(entry, out var w)) _weaponKind = w.Kind;
        else if (entry is not null && wiki.WeaponsByKind.ContainsKey(entry)) _weaponKind = entry;
        return _weaponKind ?? App.WeaponKind;
    }

    private void PickKind(string kind)
    {
        _weaponKind = kind;
        App.OpenWiki(Tab.WikiWeapons, kind);
    }

    private IEnumerable<WikiWeapon> Weapons(WikiIndex wiki, string kind) =>
        LooseSearch.Filter((wiki.WeaponsByKind.GetValueOrDefault(kind) ?? []).OrderBy(w => WikiIndex.TreeLabel(w.Tree)), w => wiki.WeaponText[w.Name], Query(Tab.WikiWeapons));

    private static string CategoryTitle(WikiIndex wiki, string key) =>
        wiki.Data.ItemCategories?.FirstOrDefault(c => c.Key == key)?.Title ?? key;

    /// <summary>The items in their categories' order (the data's own order within each).</summary>
    private IEnumerable<WikiItem> Items(WikiIndex wiki)
    {
        var order = (wiki.Data.ItemCategories ?? []).Select(c => c.Key).ToList();
        var shown = (wiki.Data.Items ?? []).OrderBy(i => order.IndexOf(i.Category) is var n && n < 0 ? int.MaxValue : n);
        return LooseSearch.Filter(shown, i => wiki.ItemText[i.Name], Query(Tab.WikiItems));
    }

    private IEnumerable<WikiMealSkill> MealSkills(WikiIndex wiki) =>
        LooseSearch.Filter((wiki.Data.Meals?.Skills ?? []).OrderBy(m => m.Name), m => wiki.MealText[m.Name], Query(Tab.WikiMeals));

    /// <summary>Every skill, set and group bonuses among them, by name; the filter narrows to one of the two.</summary>
    private IEnumerable<WikiSkill> Skills(WikiIndex wiki)
    {
        var shown = wiki.Data.Skills.Where(s => _filter switch
            {
                "skills" => s.Kind is SkillKind.Armor or SkillKind.Weapon,
                "set" => s.Kind is SkillKind.Set or SkillKind.Group,
                _ => true,
            })
            .OrderBy(s => s.Name);
        return LooseSearch.Filter(shown, s => wiki.SkillText[s.Name], Query(Tab.WikiSkills));
    }

    private IEnumerable<WikiArmorSet> Sets(WikiIndex wiki)
    {
        var query = Query(Tab.WikiArmor);
        return LooseSearch.Filter(wiki.Data.ArmorSets.Where(s => s.Rank == _rank), s => wiki.SetText[s.Name], query);
    }
}
