# Wilds Builds - the Caddy blocks for the browser app.
# Put them in the system Caddyfile (/etc/caddy/Caddyfile, replacing the old mh-optimizer.luca-diegel.de block), then:
#   sudo systemctl reload caddy
# Caddy obtains and renews the certificates itself (each name's DNS A record must point at this host).
#
# The site is static: the published wwwroot, copied to /opt/mh-optimizer/site by CI (.github/workflows/deploy.yml).

# one address for search engines and shared links: www and the old subdomain move here for good (301)
www.wildsbuilds.com, mh-optimizer.luca-diegel.de {
	redir https://wildsbuilds.com{uri} permanent
}

wildsbuilds.com {
	root * /opt/mh-optimizer/site

	# CP-SAT runs on WebAssembly threads, which need a cross-origin isolated page.
	# Without these the page falls back to coi-sw.js, which costs a reload on the first visit.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		# revalidate everything (a 304 on an unchanged file): index.html, data/ and the solver bundle are not fingerprinted
		Cache-Control "no-cache"
	}

	# page URLs such as /Luca/weapon/Current/results are client-side routes
	try_files {path} /index.html

	# the publish output has a .br and a .gz next to every file
	file_server {
		precompressed br gzip
	}
}
